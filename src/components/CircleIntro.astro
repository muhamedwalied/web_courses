---
import type { Circle } from '../schemas/roadmap';
import { Icon } from "astro-icon/components";
import { circleIcon } from "../lib/circle-icons";

interface Props {
  circle: Circle;
}

const { circle } = Astro.props;

const levelCount = circle.levels.length;
const topicCount = circle.levels.reduce((acc, l) => acc + l.modules.reduce((a, m) => a + m.topics.length, 0), 0);
const resourceCount = circle.levels.reduce(
  (acc, l) =>
    acc + l.modules.reduce((a, m) => a + m.resources.length + m.topics.reduce((t, topic) => t + topic.resources.length, 0), 0),
  0,
);
const contextChip = circle.overview?.highlights?.[0];

const coverTint = `${circle.color}22`;
const coverTintSoft = `${circle.color}05`;

const paragraphs = (circle.overview?.paragraphs?.length ? circle.overview.paragraphs : [circle.description]).filter(
  (p) => p.trim().length > 0,
);
const highlights = circle.overview?.highlights ?? [];

const toTopicsCount = (level: Circle['levels'][number]) => level.modules.reduce((a, m) => a + m.topics.length, 0);
const toModules = (level: Circle['levels'][number]) => [...level.modules].sort((a, b) => a.order - b.order);

// one resource glyph per topic row: youtube > file-text > link (build-time, no network)
const topicGlyph = (topic: Circle['levels'][number]['modules'][number]['topics'][number]) => {
  if (topic.resources.some((r) => r.kind === 'video' || r.kind === 'playlist' || /youtube\.com|youtu\.be/.test(r.url)))
    return 'lucide:youtube';
  if (topic.resources.some((r) => r.kind === 'docs' || r.kind === 'article' || r.kind === 'book' || r.kind === 'repo'))
    return 'lucide:file-text';
  return 'lucide:link';
};

// first paragraph leads the article; the rest renders expanded (the Show-more collapse
// was intentionally removed from the working tree) — the split still separates lead from body
const [leadParagraph, ...restParagraphs] = paragraphs;

const structured = circle.status === 'structured';
const taglineSegments = circle.tagline ? circle.tagline.split('→').map((s) => s.trim()).filter((s) => s.length > 0) : [];
---

<section class="grid grid-cols-1 gap-6 pt-6 pb-8 lg:grid-cols-[1fr_1.55fr]">
  <!-- first grid child renders on the RIGHT in RTL: the sticky cover box -->
  <aside class="self-start rounded-2xl border border-edge bg-panel/60 overflow-hidden max-lg:order-2 lg:sticky lg:top-20 lg:-mt-4">
    {
      circle.cover ? (
        <img src={circle.cover} alt={circle.name} loading="lazy" class="aspect-video w-full object-cover" />
      ) : (
        <div
          class="aspect-video w-full grid place-items-center"
          style={`background:linear-gradient(135deg, ${coverTint}, ${coverTintSoft}), var(--color-panel)`}
        >
          <div class="flex flex-col items-center gap-2">
            <span class="text-ink">
              <Icon name={circleIcon(circle.id)} class="size-8" />
            </span>
            <span dir="ltr" class="font-mono text-sm text-ink">
              {circle.name}
            </span>
          </div>
        </div>
      )
    }

    <div class="space-y-4 p-5">
      <!-- price-like row: big "free" + context chip -->
      <div class="flex items-baseline gap-3">
        <span class="text-3xl font-black text-ink">مجاني</span>
        {contextChip && <span class="rounded bg-edge/50 px-2 py-0.5 font-mono text-xs text-muted">{contextChip}</span>}
      </div>

      <!-- primary CTA -->
      <a
        href={`/start-${circle.id}/`}
        class="block w-full text-center rounded-lg bg-ink py-3 font-bold text-bg transition hover:opacity-85"
      >
        ابدأ المسار
      </a>

      <!-- secondary CTA -->
      <a
        href="https://github.com/CATReloaded/CATReloaded-Circles-Roadmaps"
        target="_blank"
        rel="noopener noreferrer"
        class="flex w-full items-center justify-center gap-2 rounded-lg border border-ink py-3 font-bold text-ink transition hover:bg-panel"
      >
        <Icon name="simple-icons:github" class="size-4" />
        <span>المصدر على GitHub</span>
        <Icon name="lucide:arrow-up-left" class="size-3.5" />
      </a>

      <p class="inline-flex w-full items-center justify-center gap-1.5 text-center text-xs text-muted">
        <Icon name="lucide:shield-check" class="size-3.5" />
        بدون تسجيل — تقدّمك محفوظ على جهازك
      </p>

      <hr class="border-edge/70" />

      <div class="space-y-2">
        <p class="text-sm font-bold">المسار ده يشمل:</p>
        <ul class="space-y-2 text-sm text-muted">
          <li class="flex items-center gap-2">
            <Icon name="lucide:list-tree" class="size-4 shrink-0 text-muted" />
            <span>{levelCount} مستويات</span>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="lucide:file-text" class="size-4 shrink-0 text-muted" />
            <span>{topicCount} موضوع</span>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="lucide:library" class="size-4 shrink-0 text-muted" />
            <span>{resourceCount} مصادر</span>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="lucide:infinity" class="size-4 shrink-0 text-muted" />
            <span>وصول مجاني دائم</span>
          </li>
        </ul>
      </div>

      <hr class="border-edge/70" />

      <!-- small action row -->
      <div class="flex items-center justify-center gap-2 text-xs">
        <button
          type="button"
          id="copy-link-btn"
          data-label="انسخ اللينك"
          class="inline-flex items-center gap-1 text-muted transition hover:text-ink"
        >
          <Icon name="lucide:copy" class="size-3.5" />
          <span data-label>انسخ اللينك</span>
        </button>
        <span class="text-edge">•</span>
        <a href="/" class="inline-flex items-center gap-1.5 text-muted transition hover:text-ink">
          <span>الصفحة الرئيسية</span>
          <Icon name="lucide:arrow-up-left" class="size-3.5" />
        </a>
      </div>
    </div>
  </aside>

  <!-- second grid child renders on the LEFT in RTL: the article -->
  <article class="max-lg:order-1">
    <div class="flex items-start gap-4">
      <span class="grid size-14 shrink-0 place-items-center rounded-2xl" style={`background:${circle.color}1f;box-shadow:inset 0 0 0 1px ${circle.color}40`}>
        <Icon name={circleIcon(circle.id)} class="size-7" />
      </span>
      <div>
        <div class="flex flex-wrap items-center gap-2.5">
          <h1 dir="ltr" class="text-3xl font-bold">{circle.name}</h1>
          <span class={`rounded-full px-2.5 py-0.5 font-mono text-[10px] ${structured ? 'bg-accent/10 text-accent ring-1 ring-accent/30' : 'bg-edge/40 text-muted ring-1 ring-edge'}`}>
            {structured ? 'منظّم — تقدّم قابل للتتبّع' : 'قيد الإعداد'}
          </span>
        </div>
        {circle.tagline && (
          <p class="mt-1 text-sm font-medium text-ink/90">
            {taglineSegments.length > 1
              ? taglineSegments.map((seg, i) => (
                  <>
                    {i > 0 && <span class="mx-1 text-accent-2">→</span>}
                    <span>{seg}</span>
                  </>
                ))
              : circle.tagline}
          </p>
        )}
      </div>
    </div>

    <h2 class="mt-6 text-xl font-bold">هتاخد إيه في المسار ده؟</h2>

    <div class="mt-3 space-y-2">
      {leadParagraph && <p class="text-sm leading-7 text-muted">{leadParagraph}</p>}
    </div>

    {/* body of the article: renders expanded (the Show-more collapse was intentionally removed) */}

      <div class="space-y-2">
        {restParagraphs.map((p) => (
          <p class="text-sm leading-7 text-muted">{p}</p>
        ))}
      </div>

      {
        levelCount > 0 && (
          <div class="mt-4 space-y-2">
            {circle.levels.map((level) => (
              <details class="level-acc group" open>
                <summary class="flex w-full cursor-pointer list-none items-center justify-between rounded-xl border border-edge bg-bg/40 px-3 py-2.5 transition hover:bg-panel/60 [&::-webkit-details-marker]:hidden">
                  <span class="flex items-center gap-2">
                    <Icon name="lucide:chevron-down" class="size-4 shrink-0 text-muted transition group-open:rotate-180" />
                    <span dir="ltr" class="text-sm font-bold text-ink">
                      {level.name}
                    </span>
                  </span>
                  <span class="flex shrink-0 items-center gap-2">
                    {level.durationText && (
                      <span class="rounded bg-edge/50 px-2 py-0.5 font-mono text-[10px] text-muted">{level.durationText}</span>
                    )}
                    <span class="font-mono text-[10px] text-muted">{toTopicsCount(level)} موضوع</span>
                  </span>
                </summary>

                <div class="mt-2 space-y-3 pb-1">
                  {toModules(level).map((module) => (
                    <div>
                      <p class="flex items-center gap-2 px-1 text-xs font-bold text-ink">
                        <span>{module.name}</span>
                        <span class="rounded bg-edge/50 px-1.5 py-0.5 font-mono text-[10px] font-normal text-muted">module</span>
                      </p>
                      <div class="mt-1 space-y-0.5">
                        {module.topics.map((topic) => (
                          <a
                            href={`/start-${circle.id}/#${level.id}/${module.id}/${topic.id}`}
                            class="group/row flex items-center gap-2 rounded-lg px-2 py-1.5 transition hover:bg-panel/70"
                          >
                            <Icon name="lucide:play" class="size-3.5 shrink-0 text-accent" />
                            <span dir="auto" class="truncate text-xs text-ink/90">
                              {topic.title}
                            </span>
                            <Icon name={topicGlyph(topic)} class="ms-auto size-3.5 shrink-0 text-muted" />
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </details>
            ))}
          </div>
        )
      }

    {
      highlights.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {highlights.map((h) => (
            <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-[11px] text-accent">{h}</span>
          ))}
        </div>
      )
    }
  </article>
</section>

<script>
  const btn = document.getElementById('copy-link-btn');
  if (btn) {
    btn.addEventListener('click', async () => {
      const labelEl = btn.querySelector('[data-label]');
      const label = btn.dataset.label ?? labelEl?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (labelEl) labelEl.textContent = 'تم النسخ';
        setTimeout(() => {
          if (labelEl) labelEl.textContent = label;
        }, 1500);
      } catch {
        /* clipboard unavailable — leave the label untouched */
      }
    });
  }
</script>
