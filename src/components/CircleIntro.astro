---
import type { Circle } from '../schemas/roadmap';

interface Props {
  circle: Circle;
}

const { circle } = Astro.props;

const levelCount = circle.levels.length;
const topicCount = circle.levels.reduce((acc, l) => acc + l.modules.reduce((a, m) => a + m.topics.length, 0), 0);
const resourceCount = circle.levels.reduce(
  (acc, l) =>
    acc + l.modules.reduce((a, m) => a + m.resources.length + m.topics.reduce((t, topic) => t + topic.resources.length, 0), 0),
  0,
);
const contextChip = circle.overview?.highlights?.[0];

const coverTint = `${circle.color}22`;
const coverTintSoft = `${circle.color}05`;

const paragraphs = (circle.overview?.paragraphs?.length ? circle.overview.paragraphs : [circle.description]).filter(
  (p) => p.trim().length > 0,
);
const highlights = circle.overview?.highlights ?? [];

const toTopicsCount = (level: Circle['levels'][number]) => level.modules.reduce((a, m) => a + m.topics.length, 0);

// the first paragraph stays visible; the rest of the article collapses behind a pure-CSS "show more"
const [leadParagraph, ...restParagraphs] = paragraphs;
const collapsed = restParagraphs.length > 0 || levelCount > 3;

const structured = circle.status === 'structured';
const taglineSegments = circle.tagline ? circle.tagline.split('→').map((s) => s.trim()).filter((s) => s.length > 0) : [];
---

<section class="grid grid-cols-1 gap-6 pb-8 lg:grid-cols-[1fr_1.55fr]">
  <!-- first grid child renders on the RIGHT in RTL: the sticky cover box -->
  <aside class="self-start rounded-2xl border border-edge bg-panel/60 overflow-hidden max-lg:order-2 lg:sticky lg:top-20 lg:-mt-4">
    {
      circle.cover ? (
        <img src={circle.cover} alt={circle.name} loading="lazy" class="aspect-video w-full object-cover" />
      ) : (
        <div
          class="aspect-video w-full grid place-items-center"
          style={`background:linear-gradient(135deg, ${coverTint}, ${coverTintSoft}), var(--color-panel)`}
        >
          <div class="flex flex-col items-center gap-2">
            {circle.icon && <span class="text-5xl">{circle.icon}</span>}
            <span dir="ltr" class="font-mono text-sm text-ink">
              {circle.name}
            </span>
          </div>
        </div>
      )
    }

    <div class="space-y-4 p-5">
      <!-- price-like row: big "free" + context chip -->
      <div class="flex items-baseline gap-3">
        <span class="text-3xl font-black text-ink">مجاني</span>
        {contextChip && <span class="rounded bg-edge/50 px-2 py-0.5 font-mono text-xs text-muted">{contextChip}</span>}
      </div>

      <!-- primary CTA -->
      <a
        href="#curriculum"
        class="block w-full text-center rounded-lg bg-ink py-3 font-bold text-bg transition hover:opacity-85"
      >
        ابدأ المسار
      </a>

      <!-- secondary CTA -->
      <a
        href="https://github.com/CATReloaded/CATReloaded-Circles-Roadmaps"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-center rounded-lg border border-ink py-3 font-bold text-ink transition hover:bg-panel"
      >
        المصدر على GitHub ↗
      </a>

      <p class="text-center text-xs text-muted">بدون تسجيل — تقدّمك محفوظ على جهازك</p>

      <hr class="border-edge/70" />

      <div class="space-y-2">
        <p class="text-sm font-bold">المسار ده يشمل:</p>
        <ul class="space-y-2 text-sm text-muted">
          <li class="flex items-center gap-2">
            <span aria-hidden="true">🔣</span>
            <span>{levelCount} مستويات</span>
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true">📝</span>
            <span>{topicCount} موضوع</span>
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true">📚</span>
            <span>{resourceCount} مصادر</span>
          </li>
          <li class="flex items-center gap-2">
            <span aria-hidden="true">♾️</span>
            <span>وصول مجاني دائم</span>
          </li>
        </ul>
      </div>

      <hr class="border-edge/70" />

      <!-- small action row -->
      <div class="flex items-center justify-center gap-2 text-xs">
        <button
          type="button"
          id="copy-link-btn"
          data-label="انسخ اللينك"
          class="text-muted transition hover:text-ink"
        >
          انسخ اللينك
        </button>
        <span class="text-edge">•</span>
        <a href="/" class="text-muted transition hover:text-ink">الصفحة الرئيسية ↗</a>
      </div>
    </div>
  </aside>

  <!-- second grid child renders on the LEFT in RTL: the article -->
  <article class="max-lg:order-1">
    <div class="flex items-start gap-4">
      <span class="grid size-14 shrink-0 place-items-center rounded-2xl text-2xl" style={`background:${circle.color}1f;box-shadow:inset 0 0 0 1px ${circle.color}40`}>
        {circle.icon ?? '📚'}
      </span>
      <div>
        <div class="flex flex-wrap items-center gap-2.5">
          <h1 dir="ltr" class="text-3xl font-bold">{circle.name}</h1>
          <span class={`rounded-full px-2.5 py-0.5 font-mono text-[10px] ${structured ? 'bg-accent/10 text-accent ring-1 ring-accent/30' : 'bg-edge/40 text-muted ring-1 ring-edge'}`}>
            {structured ? 'منظّم — تقدّم قابل للتتبّع' : 'قيد الإعداد'}
          </span>
        </div>
        {circle.tagline && (
          <p class="mt-1 text-sm font-medium text-ink/90">
            {taglineSegments.length > 1
              ? taglineSegments.map((seg, i) => (
                  <>
                    {i > 0 && <span class="mx-1 text-accent-2">→</span>}
                    <span>{seg}</span>
                  </>
                ))
              : circle.tagline}
          </p>
        )}
      </div>
    </div>

    <h2 class="mt-6 text-xl font-bold">هتاخد إيه في المسار ده؟</h2>

    <div class="mt-3 space-y-2">
      {leadParagraph && <p class="text-sm leading-7 text-muted">{leadParagraph}</p>}
    </div>

    {/* rest of the article: collapsible when long — always RENDERED (open) when short so the
        level rows never disappear for simple circles */}
    <details class="group" open={collapsed ? undefined : true}>
      <summary class:list={["cursor-pointer select-none py-1 font-mono text-xs text-accent marker:content-none [&::-webkit-details-marker]:hidden", ...[collapsed ? [] : ['hidden']]]}>
        <span class="block group-open:hidden">عرض المزيد ↓</span>
        <span class="hidden group-open:block">إخفاء ↑</span>
      </summary>

      <div class="space-y-2">
        {restParagraphs.map((p) => (
          <p class="text-sm leading-7 text-muted">{p}</p>
        ))}
      </div>

      {
        levelCount > 0 && (
          <ul class="mt-3 space-y-2">
            {circle.levels.map((level) => (
              <li class="rounded-xl border border-edge bg-bg/40 p-3">
                <div class="flex flex-wrap items-center gap-2">
                  <span dir="ltr" class="text-sm font-bold text-ink">
                    {level.name}
                  </span>
                  {level.durationText && (
                    <span class="rounded bg-edge/50 px-2 py-0.5 font-mono text-[10px] text-muted">{level.durationText}</span>
                  )}
                </div>
                {level.goal && <p class="mt-1 text-xs text-muted">{level.goal}</p>}
                <p class="mt-1 font-mono text-[10px] text-muted">{toTopicsCount(level)} موضوع</p>
              </li>
            ))}
          </ul>
        )
      }
    </details>

    {
      highlights.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {highlights.map((h) => (
            <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-[11px] text-accent">{h}</span>
          ))}
        </div>
      )
    }
  </article>
</section>

<script>
  const btn = document.getElementById('copy-link-btn');
  if (btn) {
    btn.addEventListener('click', async () => {
      const label = btn.dataset.label ?? btn.textContent ?? '';
      try {
        await navigator.clipboard.writeText(window.location.href);
        btn.textContent = 'تم النسخ ✓';
        setTimeout(() => {
          btn.textContent = label;
        }, 1500);
      } catch {
        /* clipboard unavailable — leave the label untouched */
      }
    });
  }
</script>
