---
import type { Circle } from '../schemas/roadmap';
import { circleTopics, countAllTopics } from '../lib/content';
import { Icon } from "astro-icon/components";
import { circleIcon } from "../lib/circle-icons";

interface Props {
  circle: Circle;
}
const { circle } = Astro.props;
const structured = circle.status === 'structured';
const counts = structured ? countAllTopics(circle) : null;
const topicKeys = structured ? circleTopics(circle).map((t) => t.key) : [];
---
<a
  href={`/circles/${circle.id}`}
  class="group relative flex flex-col gap-3 rounded-2xl border border-edge bg-panel/60 p-5 transition hover:-translate-y-0.5 hover:bg-panel"
  data-topic-keys={structured ? JSON.stringify(topicKeys) : undefined}
>
  <div class="flex items-start justify-between">
    <span class="grid size-11 place-items-center rounded-xl text-xl transition" style={`background:${circle.color}1f;box-shadow:inset 0 0 0 1px ${circle.color}40`}>
      <Icon name={circleIcon(circle.id)} class="size-5" />
    </span>
    <span class={`rounded-full px-2 py-0.5 font-mono text-[10px] ${structured ? 'bg-accent/10 text-accent ring-1 ring-accent/30' : 'bg-edge/40 text-muted ring-1 ring-edge'}`}>
      {structured ? `${counts?.required ?? 0} موضوع` : 'قيد الإعداد'}
    </span>
  </div>
  <div>
    <h3 dir="ltr" class="text-start text-lg font-bold transition group-hover:text-white">{circle.name}</h3>
    <p class="mt-1 line-clamp-2 text-sm text-muted">{circle.tagline ?? circle.description}</p>
  </div>
  {
    counts && (
      <div class="mt-auto space-y-2 border-t border-edge/70 pt-3">
        <div class="flex items-center justify-between font-mono text-[11px] text-muted">
          <span>
            {circle.levels.length} مستويات · {counts.resources} مصدر
          </span>
          <span data-pct>0/{topicKeys.length}</span>
        </div>
        <div class="h-1.5 overflow-hidden rounded-full bg-edge/70">
          <div data-bar class="h-full rounded-full transition-[width] duration-300" style={`width:0%;background:${circle.color}`}></div>
        </div>
      </div>
    )
  }
  <span
    class="pointer-events-none absolute inset-x-5 bottom-0 h-px opacity-60 transition group-hover:opacity-100"
    style={`background:linear-gradient(to left,transparent,${circle.color},transparent)`}
  ></span>
</a>
