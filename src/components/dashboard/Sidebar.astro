---
import { Icon } from 'astro-icon/components';

interface Props {
  /** المسار الحالي لتظيين العنصر النشط */
  path: string;
}
const { path } = Astro.props;

const norm = (p: string) => (p.replace(/\/+$/, '') || '/dashboard');
const current = norm(path);

// مدخلان حقيقيان فقط في v1 — الاتفاق: لا eBook ولا Code Challenges ولا مجتمع
const nav = [
  { href: '/dashboard/', label: 'لوحة التعلّم', icon: 'lucide:layout-dashboard', match: '/dashboard' },
  { href: '/dashboard/circles/', label: 'الكورسات المتاحة', icon: 'lucide:graduation-cap', match: '/dashboard/circles' },
];
const isActive = (item: (typeof nav)[number]) =>
  current === item.match || (item.match !== '/dashboard' && current.startsWith(item.match));
---

<>
  <!-- خلفية الـ drawer على الموبايل — بنفس نمط drawer محتوى الكورس -->
  <div data-dash-backdrop class="fixed inset-0 z-40 hidden bg-black/50 max-lg:block" aria-hidden="true"></div>

  <!-- sidebar الداشبورد: يمين دايمًا (start في RTL) — محصور في الشاشة مش طول الصفحة:
       sticky top-0 + h-dvh يخلي التكملة (chip البروفايل) ظاهرة دايمًا من غير نزول لآخر الصفحة -->
  <aside
    id="app-sidebar"
    dir="rtl"
    aria-label="تنقّل الداشبورد"
    class="z-50 flex w-48 shrink-0 flex-col border-e border-edge/60 bg-panel/40 max-lg:fixed max-lg:inset-y-0 max-lg:right-0 max-lg:w-64 max-lg:bg-panel max-lg:translate-x-full max-lg:transition-transform max-lg:duration-300 lg:sticky lg:top-0 lg:h-dvh lg:max-h-dvh lg:self-start"
  >
    <div class="flex items-center gap-2.5 px-3 py-4">
      <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-accent/10 text-sm font-bold text-accent ring-1 ring-accent/30">CR</span>
      <span class="flex min-w-0 flex-col leading-tight">
        <span class="truncate text-[13px] font-bold">مسارات CAT</span>
        <span class="text-[10px] text-muted">لوحة التعلّم</span>
      </span>
      <button
        type="button"
        data-dash-close
        class="ms-auto grid size-7 shrink-0 place-items-center rounded-lg text-muted transition hover:bg-panel hover:text-ink lg:hidden"
        aria-label="إغلاق القائمة"
      >
        <Icon name="lucide:x" class="size-4" />
      </button>
    </div>

    <nav class="mt-1 space-y-1 px-2" aria-label="أقسام الداشبورد">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item) ? 'page' : undefined}
            class:list={[
              'flex min-h-10 items-center gap-2.5 rounded-xl px-3 text-[13px] transition',
              isActive(item) ? 'bg-accent/10 font-bold text-accent' : 'text-muted hover:bg-panel hover:text-ink',
            ]}
          >
            <Icon name={item.icon} class="size-4 shrink-0" />
            <span class="truncate">{item.label}</span>
          </a>
        ))
      }
    </nav>

    <!-- chip البروفايل المحلي — أسفل الـ sidebar زي الـ mock -->
    <div class="relative mt-auto p-3">
      <button
        type="button"
        data-profile-chip
        class="flex w-full items-center gap-2.5 rounded-xl border border-edge bg-bg/70 px-3 py-2.5 text-start transition hover:border-accent/40"
        aria-haspopup="dialog"
        aria-expanded="false"
      >
        <span
          data-profile-avatar
          class="grid size-8 shrink-0 place-items-center rounded-full bg-accent text-sm font-bold text-bg"
          aria-hidden="true"
        >؟</span>
        <span class="min-w-0 flex-1">
          <span data-profile-name class="block truncate text-xs font-bold text-ink">مستخدم جديد</span>
          <span class="mt-0.5 flex items-center gap-1 text-[10px] text-muted">
            <Icon name="lucide:pencil" class="size-3" />
            تعديل الاسم
          </span>
        </span>
      </button>

      <!-- popover التعديل — يفتح فوق الـ chip -->
      <div
        data-profile-popover
        hidden
        class="absolute inset-x-3 bottom-full z-10 mb-2 rounded-xl border border-edge bg-surface p-3 shadow-lg"
      >
        <label for="profile-name-input" class="block text-[11px] font-bold text-ink">اسمك</label>
        <form data-profile-form class="mt-2 space-y-2">
          <input
            id="profile-name-input"
            data-profile-input
            dir="auto"
            required
            maxlength="40"
            placeholder="مثال: Medo"
            class="w-full rounded-lg border border-edge bg-bg/70 px-3 py-2 text-xs outline-none focus:border-accent"
          />
          <button type="submit" class="w-full rounded-lg bg-accent px-3 py-2 text-xs font-bold text-bg transition hover:opacity-90">
            حفظ
          </button>
        </form>
      </div>
    </div>
  </aside>
</>

<script>
  import { getProfile, setName, initialOf } from '../../lib/profile';

  // ===== drawer الموبايل (يمين — يمتد underneath من +X) =====
  const sidebar = document.getElementById('app-sidebar')!;
  const backdrop = document.querySelector<HTMLElement>('[data-dash-backdrop]');
  const CLOSED = 'max-lg:translate-x-full';
  const OPEN = 'max-lg:translate-x-0';

  function setDrawer(open: boolean) {
    sidebar.classList.toggle(CLOSED, !open);
    sidebar.classList.toggle(OPEN, open);
    backdrop?.classList.toggle('hidden', !open);
    for (const btn of document.querySelectorAll('[data-dash-menu]')) {
      btn.setAttribute('aria-expanded', String(open));
    }
  }
  const drawerOpen = () => sidebar.classList.contains(OPEN);

  for (const btn of document.querySelectorAll('[data-dash-menu]')) {
    btn.addEventListener('click', () => setDrawer(!drawerOpen()));
  }
  sidebar.querySelector('[data-dash-close]')?.addEventListener('click', () => setDrawer(false));
  backdrop?.addEventListener('click', () => setDrawer(false));

  // ===== chip البروفايل + popover التعديل =====
  const chip = sidebar.querySelector<HTMLButtonElement>('[data-profile-chip]');
  const popover = sidebar.querySelector<HTMLElement>('[data-profile-popover]');
  const input = sidebar.querySelector<HTMLInputElement>('[data-profile-input]');
  const form = sidebar.querySelector<HTMLFormElement>('[data-profile-form]');
  const nameEl = sidebar.querySelector<HTMLElement>('[data-profile-name]');
  const avatarEl = sidebar.querySelector<HTMLElement>('[data-profile-avatar]');

  function paintProfile() {
    const { name } = getProfile();
    if (nameEl) nameEl.textContent = name || 'مستخدم جديد';
    if (avatarEl) avatarEl.textContent = initialOf(name) || '؟';
  }
  paintProfile();
  window.addEventListener('dash:profile', paintProfile);

  function setPopover(open: boolean) {
    if (!popover || !chip) return;
    popover.hidden = !open;
    chip.setAttribute('aria-expanded', String(open));
    if (open) {
      if (input && !input.value) input.value = getProfile().name;
      input?.focus();
    }
  }
  chip?.addEventListener('click', () => setPopover(popover?.hidden ?? false));
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = input?.value.trim() ?? '';
    if (!value) return;
    setName(value);
    setPopover(false);
  });

  // نفس سلوك درَاور المحتوى: Escape يقفل الأقرب المفتوح
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (popover && !popover.hidden) setPopover(false);
    else if (drawerOpen()) setDrawer(false);
  });
</script>
