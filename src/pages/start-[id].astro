---
import Layout from '../layouts/Layout.astro';
import { Icon } from "astro-icon/components";
import { circleIcon } from "../lib/circle-icons";
import { getCircle, structuredCircles } from '../lib/content';
import { progressStore, tkey } from "../lib/progress";

export function getStaticPaths() {
  // only structured circles get a watch page — raw circles stay hidden from the site
  return structuredCircles.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const circle = getCircle(id as string);
if (!circle || circle.status !== 'structured') return Astro.redirect('/');

const levelCount = circle.levels.length;
const topicCount = circle.levels.reduce((acc, l) => acc + l.modules.reduce((a, m) => a + m.topics.length, 0), 0);
const resourceCount = circle.levels.reduce(
  (acc, l) =>
    acc + l.modules.reduce((a, m) => a + m.resources.length + m.topics.reduce((t, topic) => t + topic.resources.length, 0), 0),
  0,
);

const toModules = (level: (typeof circle.levels)[number]) => [...level.modules].sort((a, b) => a.order - b.order);

// flattened topic order — powers prev/next and the default lecture
const flatTopics = circle.levels.flatMap((l) =>
  toModules(l).flatMap((m) => m.topics.map((t) => ({ l: l.id, m: m.id, t: t.id, title: t.title }))),
);
const firstTopic = flatTopics[0];
const prevTopic = null;
const nextTopic = flatTopics[1] ?? null;

// one resource glyph per sidebar row: youtube > file-text > link (build-time, no network)
const topicGlyph = (topic: (typeof circle.levels)[number]['modules'][number]['topics'][number]) => {
  if (topic.resources.some((r) => r.kind === 'video' || r.kind === 'playlist' || /youtube\.com|youtu\.be/.test(r.url)))
    return 'lucide:youtube';
  if (topic.resources.some((r) => r.kind === 'docs' || r.kind === 'article' || r.kind === 'book' || r.kind === 'repo'))
    return 'lucide:file-text';
  return 'lucide:link';
};

const payload = {
  levels: circle.levels.map((l) => ({
    id: l.id,
    name: l.name,
    durationText: l.durationText ?? null,
    modules: l.modules.map((m) => ({
      id: m.id,
      name: m.name,
      objectives: m.objectives,
      practice: m.practice,
      resources: m.resources.map((r) => ({ title: r.title, url: r.url, kind: r.kind, lang: r.lang })),
      topics: m.topics.map((t) => ({
        id: t.id,
        title: t.title,
        note: t.note ?? null,
        resources: t.resources.map((r) => ({ title: r.title, url: r.url, kind: r.kind, lang: r.lang })),
      })),
    })),
  })),
  flat: flatTopics,
};
// "/" inside "</" is escaped so the JSON island can never contain a script end tag
const escaped = JSON.stringify(payload).replace(/<\//g, '<\\/');

// ---- per-lesson comments via giscus (GitHub Discussions) — like the reference
// LMS "Komentar" tab. repoId is the REST node_id (stable). categoryId is issued
// by giscus.app after: 1) enabling Discussions on the repo, 2) installing
// github.com/apps/giscus, 3) picking a category — paste it below to activate.
const giscusConfig = {
  repo: 'muhamedwalied/web_courses',
  repoId: 'R_kgDOVXFd3Q',
  category: 'Announcements',
  categoryId: '',
  lang: 'ar',
  theme: 'light',
};
const giscusEscaped = JSON.stringify(giscusConfig).replace(/</g, '\\u003C');
---

<Layout title={`ابدأ ${circle.name} — مسارات CAT Reloaded`} description={circle.description} wide>
  <div class="watch-page">
    <div class="watch-heading">
      <a href="/" class="text-muted transition hover:text-accent">المسارات</a>
      <Icon name="lucide:chevron-left" class="size-3.5 text-muted/70" />
      <a href={`/circles/${circle.id}/`} dir="auto" class="truncate text-muted transition hover:text-accent">{circle.name}</a>
      <Icon name="lucide:chevron-left" class="size-3.5 text-muted/70" />
      <span class="font-semibold text-ink">التعلّم</span>
    </div>

    <div class="watch-grid grid grid-cols-1 gap-5 pb-10 lg:grid-cols-[19rem_minmax(0,1fr)] 2xl:grid-cols-[19rem_minmax(0,1fr)_12rem]" data-circle={circle.id}>
      <!-- first grid child renders on the RIGHT in RTL: the content sidebar (Udemy-canonical).
           Desktop: docked, full-height, independently-scrolling column.
           Below lg: off-canvas drawer (fixed+right-0) — stays in the grid so RTL order is untouched. -->
      <aside
        id="content-sidebar"
        aria-label="محتوى المسار"
        class="max-lg:fixed max-lg:inset-y-0 max-lg:start-0 max-lg:z-50 max-lg:w-85 max-lg:max-w-[85vw] max-lg:translate-x-full max-lg:overflow-y-auto max-lg:rounded-none max-lg:border-s max-lg:bg-panel max-lg:p-4 max-lg:transition-transform max-lg:duration-300 lg:sticky lg:top-14 lg:flex lg:h-[calc(100dvh-3.5rem)] lg:max-h-[calc(100dvh-3.5rem)] lg:flex-col lg:self-start lg:overflow-x-hidden lg:rounded-2xl lg:border lg:border-edge lg:bg-panel/70 lg:p-4"
      >
        <div class="shrink-0 border-b border-edge/70 pb-3">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-sm font-bold">محتوى المسار</h2>
            <button
              type="button"
              id="content-close"
              class="grid size-7 shrink-0 place-items-center rounded-lg text-muted transition hover:bg-panel hover:text-ink lg:hidden"
              aria-label="إغلاق"
            >
              <Icon name="lucide:x" class="size-4" />
            </button>
          </div>
          <p class="mt-1 font-mono text-[10px] text-muted">{levelCount} مستويات · {topicCount} درس · {resourceCount} مصدر</p>
          <div
            id="watch-progress"
            role="progressbar"
            aria-label="تقدّمك في المسار"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            class="watch-progress mt-3 rounded-xl bg-bg/70 p-2.5"
          >
            <div class="flex items-center justify-between gap-2 font-mono text-[10px] text-muted">
              <span>أكملت <b id="watch-prog-count" class="text-ink">0</b> من {topicCount}</span>
              <span id="watch-prog-pct">0%</span>
            </div>
            <span class="wbar mt-2"><i id="watch-prog-bar"></i></span>
            <span id="watch-prog-left" class="mt-1 block text-[10px] text-muted">{topicCount} درس متبقي</span>
          </div>
        </div>

        <div class="mt-3 min-h-0 flex-1 space-y-2 overflow-y-auto pe-1">
          {circle.levels.map((level) => (
            <details class="level-acc group" data-level={level.id} open>
              <summary class="flex w-full cursor-pointer list-none items-center justify-between rounded-xl border border-edge bg-bg/40 px-3 py-2.5 transition hover:bg-panel/60 [&::-webkit-details-marker]:hidden">
                <span class="flex items-center gap-2">
                  <Icon name="lucide:chevron-down" class="size-4 shrink-0 text-muted transition group-open:rotate-180" />
                  <span dir="auto" class="text-sm font-bold text-ink">{level.name}</span>
                </span>
                <span class="flex shrink-0 items-center gap-2">
                  {level.durationText && (
                    <span class="rounded bg-edge/50 px-2 py-0.5 font-mono text-[10px] text-muted">{level.durationText}</span>
                  )}
                  <span class="font-mono text-[10px] text-muted">
                    {level.modules.reduce((a, m) => a + m.topics.length, 0)} موضوع
                  </span>
                </span>
              </summary>

              <div class="mt-2 space-y-3 pb-1">
                {toModules(level).map((module) => (
                  <div>
                    <p class="flex items-center gap-2 px-1 text-xs font-bold text-ink">
                      <span>{module.name}</span>
                      <span class="rounded bg-edge/50 px-1.5 py-0.5 font-mono text-[10px] font-normal text-muted">وحدة</span>
                    </p>
                    <div class="mt-1 space-y-0.5">
                      {module.topics.map((topic) => (
                        <a
                          href={`#${level.id}/${module.id}/${topic.id}`}
                          data-key={`${level.id}/${module.id}/${topic.id}`}
                          data-tkey={tkey(circle.id, level.id, module.id, topic.id)}
                          class="group/row flex items-center gap-2 rounded-lg px-2 py-1.5 transition hover:bg-panel/70"
                        >
                          <span class="wdot shrink-0" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
                              ><path d="M20 6 9 17l-5-5"></path
                            ></svg>
                          </span>
                          <span dir="auto" class="truncate text-xs text-ink/90" data-rowtitle>{topic.title}</span>
                          {topic.resources.some((r) => (r.kind === 'video' || r.kind === 'playlist') && r.lang === 'ar') && (
                            <span class="shrink-0 rounded bg-accent/10 px-1.5 py-0.5 font-mono text-[9px] font-bold text-accent/80">عربي</span>
                          )}
                          <Icon name={topicGlyph(topic)} class="ms-auto size-3.5 shrink-0 text-muted" />
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </details>
          ))}
        </div>
      </aside>

      <!-- mobile drawer backdrop — below lg only, toggled by JS -->
      <div id="content-backdrop" class="fixed inset-0 z-40 hidden bg-black/50" aria-hidden="true"></div>

      <!-- Center column: the current lesson and its learning controls. -->
      <div class="watch-main min-w-0">
        <div class="watch-titlebar mt-1 flex items-center gap-3 px-1 py-3">
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-accent/10 text-accent ring-1 ring-accent/20">
            <Icon name="lucide:book-open" class="size-5" />
          </span>
          <div class="min-w-0">
            <p id="watch-crumb" class="truncate text-xs text-muted" dir="auto">
              {firstTopic ? `${firstTopic.l} / ${firstTopic.m}` : ''}
            </p>
            <h1 id="watch-title" class="mt-1 line-clamp-2 text-xl font-bold leading-relaxed text-ink sm:text-2xl">
              {firstTopic?.title ?? circle.name}
            </h1>
          </div>

          <button
            type="button"
            id="content-toggle"
            aria-expanded="false"
            aria-controls="content-sidebar"
            class="ms-auto inline-flex shrink-0 items-center gap-1.5 rounded-xl border border-edge bg-panel px-3 py-2 text-xs font-bold text-ink transition hover:border-accent/50 hover:text-accent lg:hidden"
          >
            <Icon name="lucide:list-tree" class="size-4 shrink-0" />
            <span>المحتوى</span>
          </button>
        </div>

        <div
          id="watch-stage"
          class="watch-stage relative mt-2 grid aspect-video place-items-center overflow-hidden rounded-2xl border border-edge bg-black/60"
        >
          <button
            type="button"
            id="watch-facade"
            class="grid size-16 place-items-center rounded-full bg-bg text-accent shadow-xl ring-1 ring-white/30 transition hover:bg-panel focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
            aria-label="شغّل المحاضرة"
          >
            <Icon name="lucide:play" class="size-8" />
          </button>
        </div>

        <div class="watch-tabs mt-4 flex items-center gap-1 border-b border-edge/80" role="navigation" aria-label="أقسام الدرس">
          <a href="#watch-overview" class="watch-tab is-active">نظرة عامة</a>
          <a href="#watch-comments" class="watch-tab" data-open-comments>المناقشة</a>
        </div>

        <section id="watch-overview" class="watch-overview mt-4">
          <h2 class="text-base font-bold text-ink">عن هذا الدرس</h2>
          <p class="mt-1 text-xs leading-6 text-muted">تابع الدرس، ثم علّم عليه كمكتمل لتحديث تقدّمك في المسار.</p>
          <div id="watch-extras" class="mt-4 space-y-3"></div>
        </section>

        <label class="mt-4 flex w-fit items-center gap-2 rounded-xl border border-edge bg-panel/60 px-3 py-2.5 text-xs text-muted transition hover:border-accent/40 hover:text-ink">
          <input type="checkbox" id="watch-done" class="size-3.5 accent-[var(--color-accent)]" />
          <span>خلصت المحاضرة دي؟</span>
        </label>

        <div class="mt-4 flex justify-between gap-3">
          <a
            href={prevTopic ? `#${prevTopic.l}/${prevTopic.m}/${prevTopic.t}` : firstTopic ? `#${firstTopic.l}/${firstTopic.m}/${firstTopic.t}` : '#'}
            id="watch-prev"
            data-edge={prevTopic ? '0' : '1'}
            aria-disabled={prevTopic ? undefined : 'true'}
            class="flex items-center gap-1.5 rounded-xl border border-edge bg-panel/60 px-4 py-2.5 text-xs text-ink transition hover:border-accent/40 hover:bg-panel aria-disabled:pointer-events-none aria-disabled:opacity-40"
          >
            <Icon name="lucide:arrow-right" class="size-3.5" />
            <span>السابق</span>
          </a>

          <a
            href={nextTopic ? `#${nextTopic.l}/${nextTopic.m}/${nextTopic.t}` : firstTopic ? `#${firstTopic.l}/${firstTopic.m}/${firstTopic.t}` : '#'}
            id="watch-next"
            data-edge={nextTopic ? '0' : '1'}
            aria-disabled={nextTopic ? undefined : 'true'}
            class="flex items-center gap-1.5 rounded-xl bg-accent px-4 py-2.5 text-xs font-bold text-bg transition hover:opacity-90 aria-disabled:pointer-events-none aria-disabled:opacity-40"
          >
            <span>التالي</span>
            <Icon name="lucide:arrow-left" class="size-3.5" />
          </a>
        </div>

        <!-- per-lesson GitHub Discussions (giscus) — each lesson owns a thread; mounts lazily when opened -->
        <details id="watch-comments" class="group mt-5 scroll-mt-20 rounded-xl border border-edge bg-panel/60">
          <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 text-xs font-bold text-ink [&::-webkit-details-marker]:hidden">
            <Icon name="lucide:message-circle" class="size-4 shrink-0 text-accent" />
            <span>المناقشة — تعليقات GitHub عن المحاضرة</span>
            <span class="hidden font-mono text-[10px] font-normal text-muted sm:inline">ديسكاشن مستقلة لكل درس</span>
            <Icon name="lucide:chevron-down" class="ms-auto size-4 shrink-0 text-muted transition group-open:rotate-180" />
          </summary>
          <div class="border-t border-edge/80 px-4 py-3">
            <div id="watch-comments-mount"></div>
          </div>
        </details>
      </div>

      <!-- A compact course rail appears only on wide screens; the site header remains the primary global navigation. -->
      <aside class="watch-rail hidden 2xl:flex 2xl:flex-col" aria-label="تنقّل التعلّم">
        <a href="/" class="watch-brand flex items-center gap-2.5 rounded-xl px-2 py-3 text-ink transition hover:bg-panel">
          <span class="grid size-9 place-items-center rounded-xl bg-accent/10 text-xs font-black text-accent ring-1 ring-accent/20">CR</span>
          <span><span class="block text-xs font-bold">مسارات CAT</span><span class="mt-0.5 block text-[10px] text-muted">مساحة التعلّم</span></span>
        </a>
        <p class="mt-8 px-2 text-[10px] font-bold text-muted">التنقّل</p>
        <nav class="mt-2 space-y-1" aria-label="أقسام مساحة التعلّم">
          <a href="/" class="watch-rail-link"><Icon name="lucide:library" class="size-4" /><span>كل المسارات</span></a>
          <a href={`/circles/${circle.id}/`} class="watch-rail-link"><Icon name={circleIcon(circle.id)} class="size-4" /><span class="truncate" dir="auto">صفحة المسار</span></a>
          <a href="#watch-stage" class="watch-rail-link is-current"><Icon name="lucide:play" class="size-4" /><span>مشاهدة الدرس</span></a>
          <a href="#content-sidebar" class="watch-rail-link"><Icon name="lucide:list-tree" class="size-4" /><span>محتوى المسار</span></a>
        </nav>
        <div class="mt-auto rounded-xl border border-edge/80 bg-panel/60 p-3">
          <span class="grid size-8 place-items-center rounded-lg bg-accent/10 text-accent"><Icon name="lucide:bookmark-check" class="size-4" /></span>
          <p class="mt-2 text-xs font-bold text-ink">تقدّمك محفوظ</p>
          <p class="mt-1 text-[10px] leading-5 text-muted">تُحفظ الدروس المكتملة على هذا الجهاز.</p>
        </div>
      </aside>
    </div>
  </div>

  <script type="application/json" id="watch-data" data-circle={circle.id} set:html={escaped}></script>
  <script type="application/json" id="giscus-config" set:html={giscusEscaped}></script>

  <script>
    // runs in the browser — this import must live INSIDE the client script
    // (frontmatter imports never reach the bundled client code)
    import { progressStore, tkey } from "../lib/progress";

    // --- Iconify path data (lucide) ---
    const LUCIDE = {
      play: 'M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z',
      'external-link':
        'M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6',
      'file-text': 'M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Zm-1 0v6h6',
      check: 'M20 6 9 17l-5-5',
    };

    function svgIcon(name, cls, extra = '') {
      const d = LUCIDE[name];
      if (!d) return null;
      const NS = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(NS, 'svg');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('stroke-width', '2');
      svg.setAttribute('stroke-linecap', 'round');
      svg.setAttribute('stroke-linejoin', 'round');
      svg.setAttribute('aria-hidden', 'true');
      if (cls) svg.setAttribute('class', cls);
      if (extra) for (const chunk of extra.split(',')) {
        const [k, ...rest] = chunk.split('=');
        svg.setAttribute(k, rest.join('='));
      }
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('d', d);
      svg.appendChild(path);
      return svg;
    }

    const dataEl = document.getElementById('watch-data');
    const payload = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};
    const levels = payload.levels || [];
    const flat = payload.flat || [];
    const CIRCLE_ID = dataEl?.dataset.circle || document.querySelector('[data-circle]')?.dataset.circle || '';

    const stage = document.getElementById('watch-stage');
    const titleEl = document.getElementById('watch-title');
    const crumbEl = document.getElementById('watch-crumb');
    const doneEl = document.getElementById('watch-done');
    const prevEl = document.getElementById('watch-prev');
    const nextEl = document.getElementById('watch-next');
    const rows = Array.from(document.querySelectorAll('a[data-key]'));

    // progress strip refs (bar + count + percent + remaining)
    const progBarEl = document.getElementById('watch-prog-bar');
    const progCountEl = document.getElementById('watch-prog-count');
    const progPctEl = document.getElementById('watch-prog-pct');
    const progLeftEl = document.getElementById('watch-prog-left');
    const progressStrip = document.getElementById('watch-progress');
    const allTkeys = rows.map((r) => r.dataset.tkey).filter(Boolean);

    const keyOf = (l, m, t) => l + '/' + m + '/' + t;

    function findTopic(l, m, t) {
      const level = levels.find((x) => x.id === l);
      if (!level) return null;
      const mod = level.modules.find((x) => x.id === m);
      if (!mod) return null;
      const topic = mod.topics.find((x) => x.id === t);
      if (!topic) return null;
      return { level, module: mod, topic };
    }

    /** youtube nocookie embed src for single videos AND playlists (videoseries); null = not embeddable */
    function embedSrc(url) {
      try {
        const u = new URL(url, location.href);
        const host = u.hostname.replace(/^www\./, '').replace(/^m\./, '');
        const list = u.searchParams.get('list');
        let videoId = null;
        if (host === 'youtu.be') {
          videoId = u.pathname.split('/').filter(Boolean)[0] || null;
        } else if (host === 'youtube.com' || host === 'youtube-nocookie.com' || host === 'music.youtube.com') {
          if (u.pathname === '/watch') videoId = u.searchParams.get('v') || null;
          else {
            const parts = u.pathname.split('/').filter(Boolean);
            if (parts[0] === 'embed' || parts[0] === 'shorts' || parts[0] === 'live' || parts[0] === 'v') videoId = parts[1] || null;
          }
        }
        const q = new URLSearchParams({ autoplay: '1', rel: '0' });
        if (videoId) {
          if (list) q.set('list', list);
          return 'https://www.youtube-nocookie.com/embed/' + videoId + '?' + q.toString();
        }
        // playlist-only link (e.g. Elzero course playlists) -> videoseries embed, stays on-site
        if (host === 'youtube.com' && u.pathname === '/playlist' && list) {
          return 'https://www.youtube-nocookie.com/embed/videoseries?' + q.toString() + '&list=' + encodeURIComponent(list);
        }
        return null;
      } catch {
        return null;
      }
    }

    const isEmbeddableResource = (r) => {
      if (!r || (r.kind !== 'video' && r.kind !== 'playlist')) return false;
      return embedSrc(r.url) !== null;
    };

    function plain(tag, cls, text) {
      const el = document.createElement(tag);
      if (cls) el.className = cls;
      if (text != null) el.textContent = text;
      return el;
    }

    function outboundButton(r, cls) {
      const a = document.createElement('a');
      a.href = r.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.className = cls;
      a.appendChild(svgIcon('external-link', 'size-3.5 shrink-0'));
      const label = plain('span', 'truncate', r.title || 'افتح المصدر');
      a.appendChild(label);
      return a;
    }

    function renderFacade(entry) {
      const film = plain('div', 'flex aspect-video w-full flex-col items-center justify-center gap-4 bg-ink');
      const btn = plain('button', 'grid size-16 place-items-center rounded-full bg-bg text-accent shadow-xl ring-1 ring-white/30 transition hover:bg-panel');
      btn.type = 'button';
      const big = svgIcon('play', 'size-9');
      if (big) btn.appendChild(big);
      btn.setAttribute('aria-label', 'شغّل الفيديو: ' + (entry.topic.title || ''));
      btn.addEventListener('click', () => startPlayback(entry));
      film.appendChild(btn);
      film.appendChild(plain('p', 'max-w-lg truncate px-4 text-center text-sm font-bold text-bg', entry.video.title || entry.topic.title || ''));
      film.appendChild(plain('p', 'font-mono text-[10px] text-bg/65', 'يوتيوب · تشغيل داخل الموقع'));
      return film;
    }

    // ---- language of playback: the site is Arabic-first -----------------------
    // a lecture that ships an Arabic version never defaults to the English one;
    // when both exist, a small switcher shows above the extras.
    const langPref = () => {
      try {
        return localStorage.getItem('cr-video-lang') || 'ar';
      } catch {
        return 'ar';
      }
    };

    const videoScore = (r, pref) => (r.lang === pref ? 2 : 0) + (r.lang ? 1 : 0);

    function pickPreferredVideo(videos) {
      if (!videos || !videos.length) return null;
      const pref = langPref();
      return [...videos].sort((a, b) => videoScore(b, pref) - videoScore(a, pref))[0];
    }

    function startPlayback(entry) {
      const src = embedSrc(entry.video && entry.video.url);
      if (!src || !stage) return;
      const frame = document.createElement('iframe');
      frame.src = src;
      frame.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture');
      frame.setAttribute('allowfullscreen', '');
      frame.setAttribute('loading', 'lazy');
      frame.className = 'absolute inset-0 h-full w-full';
      stage.replaceChildren(frame);
      stage.dataset.playing = '1';
    }

    function selectVideoLanguage(entry, url) {
      const chosen = (entry.videos || []).find((r) => r.url === url);
      if (!chosen) return;
      try {
        localStorage.setItem('cr-video-lang', chosen.lang || 'en');
      } catch {}
      entry.video = chosen;
      if (!stage) return;
      if (stage.dataset.playing === '1') {
        startPlayback(entry); // keep watching — swap the source in place
      } else {
        stage.replaceChildren(renderFacade(entry));
      }
      const oldBar = document.getElementById('watch-lang');
      if (oldBar) {
        const fresh = renderLanguageSwitch(entry);
        if (fresh) oldBar.replaceWith(fresh);
      }
    }

    // «Vue for Beginners» vs «Vue for Beginners (Arabic)» → same lecture, two takes.
    // Different stems (study playlist + project video) are NOT versions of one lecture.
    const titleStem = (t) => (t || '').toLowerCase().replace(/\(.*?\)/g, '').replace(/[^a-z\u0600-\u06FF]+/g, '');

    function sameLecture(videos) {
      if (videos.length < 2) return true;
      const stem = titleStem(videos[0].title).slice(0, 14);
      return videos.every((r) => titleStem(r.title).slice(0, 14) === stem);
    }

    /** rendered when a topic ships more than one playable video: twin titles show as
        language versions («النسخة: عربي · English»), different videos as a source list */
    function renderLanguageSwitch(entry) {
      const videos = entry.videos || [];
      if (videos.length < 2) return null;
      const bar = plain('div', 'mt-2 flex flex-wrap items-center gap-2 text-xs');
      bar.id = 'watch-lang';
      const twin = sameLecture(videos);
      bar.appendChild(plain('span', 'font-mono text-[10px] text-muted', twin ? 'النسخة:' : 'مصادر فيديو المحاضرة:'));
      const labels = { ar: 'عربي', en: 'إنجليزي' };
      const langBadge = (lang) =>
        plain('span', 'rounded bg-accent/10 px-1 font-mono text-[9px] font-bold text-accent/80', labels[lang] || lang);
      for (const r of videos) {
        const lang = r.lang || 'en';
        const active = entry.video && entry.video.url === r.url;
        const b = plain(
          'button',
          active
            ? 'inline-flex items-center gap-1 rounded-md bg-accent/15 px-2.5 py-1 font-bold text-accent ring-1 ring-accent/40'
            : 'inline-flex items-center gap-1 rounded-md px-2.5 py-1 text-muted ring-1 ring-edge transition hover:text-ink',
        );
        b.type = 'button';
        b.setAttribute('aria-pressed', String(!!active));
        b.appendChild(plain('span', null, twin ? labels[lang] || lang : (r.title || '').slice(0, 34)));
        if (!twin) b.appendChild(langBadge(lang));
        b.addEventListener('click', () => selectVideoLanguage(entry, r.url));
        bar.appendChild(b);
      }
      return bar;
    }

    // stage sizing: video mode keeps the 16:9 player box, article mode becomes a readable column
    const VIDEO_STAGE_CLASSES = ['relative', 'overflow-hidden', 'rounded-2xl', 'border', 'border-edge', 'mt-3', 'grid', 'aspect-video', 'place-items-center', 'bg-black/60'];
    const ARTICLE_STAGE_CLASSES = ['relative', 'overflow-hidden', 'rounded-2xl', 'border', 'border-edge', 'mt-3', 'block', 'bg-panel/60'];

    function setStageMode(isArticle) {
      if (!stage) return;
      stage.classList.remove(...VIDEO_STAGE_CLASSES, ...ARTICLE_STAGE_CLASSES);
      stage.classList.add(...(isArticle ? ARTICLE_STAGE_CLASSES : VIDEO_STAGE_CLASSES));
    }

    const hostOf = (url) => {
      try {
        return new URL(url, location.href).hostname.replace(/^www\./, '');
      } catch {
        return url;
      }
    };

    function chipRow(entry) {
      const chips = entry.topic.resources.filter((r) => !isEmbeddableResource(r));
      if (!chips.length) return null;
      const wrap = plain('div', 'mt-3 flex flex-wrap gap-2');
      for (const r of chips) {
        wrap.appendChild(outboundButton(r, 'inline-flex max-w-full items-center gap-1.5 rounded-lg border border-edge px-3 py-1.5 text-xs text-ink transition hover:border-accent/40'));
      }
      return wrap;
    }

    /** Note, objectives and source links rendered in the overview panel. */
    function renderExtras(entry) {
      const box = plain('div', 'rounded-2xl border border-edge bg-panel/60 p-4 space-y-2');

      if (entry.topic.note) box.appendChild(plain('p', 'text-sm leading-7 text-muted', entry.topic.note));

      const objectives = entry.module.objectives || [];
      if (objectives.length) {
        box.appendChild(plain('p', 'text-xs font-bold text-ink', 'أهداف الوحدة'));
        const list = plain('ul', 'space-y-1');
        for (const text of objectives.slice(0, 6)) {
          const li = plain('li', 'flex items-start gap-2 text-xs leading-6 text-muted');
          const tick = svgIcon('check', 'mt-0.5 size-3.5 shrink-0 text-accent-2');
          if (tick) li.appendChild(tick);
          li.appendChild(plain('span', 'text-ink/90', text));
          list.appendChild(li);
        }
        box.appendChild(list);
      }

      const chips = entry.topic.resources.filter((r) => !isEmbeddableResource(r));
      if (chips.length) {
        box.appendChild(plain('p', 'text-xs font-bold', 'مصادر المحاضرة'));
        const wrap = plain('div', 'flex flex-wrap gap-2');
        for (const r of chips) {
          wrap.appendChild(outboundButton(r, 'inline-flex max-w-full items-center gap-1.5 rounded-lg border border-edge px-3 py-1.5 text-xs text-ink transition hover:border-accent/40'));
        }
        box.appendChild(wrap);
      }

      return box;
    }

    /** one "source site" row for the resources list — full row, not a chip */
    function sourceRow(r) {
      const a = document.createElement('a');
      a.href = r.url;
      a.target = '_blank';
      a.rel = 'nofollow noopener';
      a.className = 'flex items-center gap-3 rounded-xl border border-edge bg-bg/40 px-3 py-2.5 transition hover:border-accent/40';

      const lead = svgIcon('external-link', 'size-4 shrink-0 text-muted');
      if (lead) a.appendChild(lead);

      const col = plain('span', 'flex min-w-0 flex-col');
      const name = plain('span', 'truncate text-xs font-bold text-ink', r.title || 'افتح المصدر');
      name.dir = 'auto';
      col.appendChild(name);
      col.appendChild(plain('span', 'font-mono text-[10px] text-muted', hostOf(r.url)));
      a.appendChild(col);

      const tail = svgIcon('external-link', 'ms-auto size-3.5 shrink-0 text-muted');
      if (tail) a.appendChild(tail);

      return a;
    }

    /** video-less topics are READING LECTURES: a full-width article column inside the stage */
    function renderArticle(entry) {
      const article = plain('div', 'w-full px-6 py-6');
      const inner = plain('div', 'mx-auto max-w-[62ch] space-y-4 text-right');

      const kicker = plain('p', 'flex items-center gap-2 font-mono text-[10px] text-accent');
      const glyph = svgIcon('file-text', 'size-3.5 shrink-0');
      if (glyph) kicker.appendChild(glyph);
      kicker.appendChild(plain('span', null, 'مقالة — محاضرة قراءة'));
      inner.appendChild(kicker);

      const lead = entry.topic.note
        ? entry.topic.note
        : 'محاضرة قراءة — بتتناول: ' + (entry.topic.title || '') + '. المحتوى الكامل على المصادر المرتبطة بالأسفل.';
      inner.appendChild(plain('p', 'text-sm leading-7 text-muted', lead));

      const objectives = entry.module.objectives || [];
      if (objectives.length) {
        inner.appendChild(plain('p', 'text-xs font-bold text-ink', 'أهداف الوحدة'));
        const list = plain('ul', 'space-y-1');
        for (const text of objectives.slice(0, 6)) {
          const li = plain('li', 'flex items-start gap-2 text-xs leading-6 text-muted');
          const tick = svgIcon('check', 'mt-0.5 size-3.5 shrink-0 text-accent-2');
          if (tick) li.appendChild(tick);
          li.appendChild(plain('span', 'text-ink/90', text));
          list.appendChild(li);
        }
        inner.appendChild(list);
      }

      inner.appendChild(plain('p', 'text-xs font-bold text-ink', 'مصادر المحاضرة'));
      const resources = entry.topic.resources || [];
      if (resources.length) {
        const list = plain('div', 'space-y-2');
        for (const r of resources) list.appendChild(sourceRow(r));
        inner.appendChild(list);
      } else {
        inner.appendChild(plain('p', 'text-xs text-muted', 'مفيش مصادر مرفقة بالموضوع ده.'));
      }

      article.appendChild(inner);
      return article;
    }

    function renderSidebar() {
      const snapshot = progressStore.snapshot();
      for (const row of rows) {
        const tkeyValue = row.dataset.tkey;
        const done = !!(tkeyValue && snapshot[tkeyValue] === 1);
        // done marker (from «مسار تعلّم تفاعلي ٢»): the circular dot fills with a
        // white check and the title mutes — the dot itself stays full-strength.
        const dot = row.querySelector('.wdot');
        if (dot) dot.classList.toggle('is-done', done);
        const label = row.querySelector('[data-rowtitle]');
        if (label) label.classList.toggle('text-muted', done);
      }
    }

    function setCurrentRow(currentKey) {
      for (const row of rows) {
        const isCurrent = row.dataset.key === currentKey;
        if (isCurrent) row.dataset.current = '';
        else delete row.dataset.current;
        row.classList.toggle('bg-accent/10', isCurrent);
        row.classList.toggle('text-accent', isCurrent);
        row.classList.toggle('ring-1', isCurrent);
        row.classList.toggle('ring-accent/30', isCurrent);
        if (isCurrent) {
          const details = row.closest('details');
          // property, not setAttribute: setting the attribute twice silently closes it
          if (details) details.open = true;
        }
      }
    }

    function renderEdges(index) {
      const edges = [
        { el: prevEl, target: index > 0 ? flat[index - 1] : null, self: flat[index] },
        { el: nextEl, target: index + 1 < flat.length ? flat[index + 1] : null, self: flat[index] },
      ];
      for (const { el, target, self } of edges) {
        if (!el) continue;
        const dest = target || self;
        el.setAttribute('href', dest ? '#' + keyOf(dest.l, dest.m, dest.t) : '#');
        if (target) {
          el.removeAttribute('aria-disabled');
          el.dataset.edge = '0';
        } else {
          el.setAttribute('aria-disabled', 'true');
          el.dataset.edge = '1';
        }
      }
    }

    function render(key) {
      let index = flat.findIndex((f) => keyOf(f.l, f.m, f.t) === key);
      if (index < 0) index = 0;
      const entry = flat[index];
      if (!entry) return;
      const found = findTopic(entry.l, entry.m, entry.t);
      if (!found) return;

      entry.topic = found.topic;
      entry.module = found.module;
      entry.level = found.level;

      // playback resolves ONLY from the topic's own embeddable resources —
      // no module/sibling fallback: a lecture without its own video is a reading lecture.
      // Arabic-first: when the same lecture ships both versions, the Arabic one plays.
      entry.videos = (entry.topic.resources || []).filter((r) => isEmbeddableResource(r));
      entry.video = pickPreferredVideo(entry.videos);

      const currentKey = keyOf(entry.l, entry.m, entry.t);
      window.__watchCurrentKey = currentKey;

      if (titleEl) titleEl.textContent = found.topic.title || '';
      if (crumbEl) crumbEl.textContent = found.level.name + ' · ' + found.module.name;

      setCurrentRow(currentKey);

      // Rebuild the overview and language controls for the selected lesson.
      const extrasEl = document.getElementById('watch-extras');
      extrasEl?.replaceChildren();
      const oldLangBar = document.getElementById('watch-lang');
      if (oldLangBar) oldLangBar.remove();
      if (stage) delete stage.dataset.playing;

      if (stage) {
        const hasVideo = !!entry.video;
        setStageMode(!hasVideo);
        if (hasVideo) {
          stage.replaceChildren(renderFacade(entry));
          const extras = renderExtras(entry);
          if (extras && (entry.topic.note || entry.module.objectives?.length || entry.topic.resources.some((r) => !isEmbeddableResource(r)))) {
            extrasEl?.appendChild(extras);
          }
          const langBar = renderLanguageSwitch(entry);
          if (langBar) stage.insertAdjacentElement('afterend', langBar);
        } else {
          stage.replaceChildren(renderArticle(entry));
        }
      }

      if (doneEl) {
        // always the key of the topic on screen — never a cached one from a previous render
        const tkeyValue = tkey(CIRCLE_ID, entry.l, entry.m, entry.t);
        doneEl.dataset.tkey = tkeyValue;
        doneEl.checked = progressStore.snapshot()[tkeyValue] === 1;
      }

      renderSidebar();
      renderEdges(index);
      mountComments(found.topic.title);
    }

    /** "#l/m/t" -> ["l","m","t"] */
    function parseHash(hash) {
      return (hash || '').replace(/^#/, '').split('/').filter(Boolean);
    }

    function keyFromLocation() {
      const parts = parseHash(location.hash);
      if (parts.length < 3) return '';
      return keyOf(parts[0], parts[1], parts[2]);
    }

    // ---- per-lesson comments (giscus / GitHub Discussions) -------------------
    // one discussion thread per lesson title (specific-term mapping); the giscus
    // script only loads once the section is opened (loading=lazy inside <details>).
    const giscusMount = document.getElementById('watch-comments-mount');
    let giscusConfig = null;
    try {
      giscusConfig = JSON.parse(document.getElementById('giscus-config')?.textContent || 'null');
    } catch {}
    let currentCommentTerm = '';

    function commentSetupPlaceholder(term) {
      const box = plain('div', 'rounded-lg border border-dashed border-edge bg-bg/40 p-4 text-xs leading-6 text-muted');
      box.appendChild(plain('p', 'font-bold text-ink', 'تعليقات GitHub (giscus) محتاجة خطوة إعداد لمرة واحدة:'));
      const list = plain('ol', 'list-decimal space-y-1 ps-5');
      for (const step of [
        'فعّل Discussions في مستودع ' + (giscusConfig?.repo || 'المشروع') + ' من الإعدادات، ثم General، ثم Features.',
        'ثبّت التطبيق github.com/apps/giscus على المستودع.',
        'افتح giscus.app واكتب اسم المستودع، ثم انسخ قيمة data-category-id للتصنيف الذي تختاره وضَعها في giscusConfig.categoryId داخل src/pages/start-[id].astro.',
      ]) {
        list.appendChild(plain('li', null, step));
      }
      box.appendChild(list);
      box.appendChild(plain('p', 'mt-2', 'كل محاضرة بياخد ديسكاشن مستقلة عنها بالعنوان: ' + term));
      return box;
    }

    function mountComments(term) {
      if (!giscusMount) return;
      if (currentCommentTerm === term) return;
      currentCommentTerm = term;
      giscusMount.replaceChildren();
      if (!giscusConfig || !giscusConfig.categoryId) {
        giscusMount.appendChild(commentSetupPlaceholder(term));
        return;
      }
      const s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      s.setAttribute('data-repo', giscusConfig.repo);
      s.setAttribute('data-repo-id', giscusConfig.repoId);
      s.setAttribute('data-category', giscusConfig.category);
      s.setAttribute('data-category-id', giscusConfig.categoryId);
      s.setAttribute('data-mapping', 'specific-term');
      s.setAttribute('data-term', term);
      s.setAttribute('data-strict', '0');
      s.setAttribute('data-reactions-enabled', '1');
      s.setAttribute('data-emit-metadata', '0');
      s.setAttribute('data-input-position', 'top');
      s.setAttribute('data-theme', giscusConfig.theme || 'light');
      s.setAttribute('data-lang', giscusConfig.lang || 'ar');
      s.setAttribute('data-loading', 'lazy');
      s.crossOrigin = 'anonymous';
      s.async = true;
      giscusMount.appendChild(s);
    }

    if (rows.length) {
      render(keyFromLocation() || keyOf(flat[0]?.l, flat[0]?.m, flat[0]?.t));
    }

    // progress strip — countDone over every sidebar row key; subscribe covers the
    // checkbox on this page AND cross-tab storage events from any other page.
    function updateProgressUI() {
      const total = flat.length;
      const done = progressStore.countDone(allTkeys);
      const pct = total ? Math.round((done / total) * 100) : 0;
      if (progBarEl) progBarEl.style.transform = 'scaleX(' + (total ? done / total : 0) + ')';
      if (progCountEl) progCountEl.textContent = String(done);
      if (progPctEl) progPctEl.textContent = pct + '%';
      if (progLeftEl) progLeftEl.textContent = (total - done) + ' درس متبقي';
      if (progressStrip) progressStrip.setAttribute('aria-valuenow', String(pct));
    }
    updateProgressUI();
    progressStore.subscribe(updateProgressUI);

    if (doneEl) {
      doneEl.addEventListener('change', () => {
        const key = doneEl.dataset.tkey;
        if (key) progressStore.toggle(key);
        renderSidebar();
      });
    }

    addEventListener('hashchange', () => {
      const key = keyFromLocation();
      if (!key || key === window.__watchCurrentKey) return;
      render(key);
    });

    // --- mobile content drawer (below lg only) ---
    const sidebarEl = document.getElementById('content-sidebar');
    const backdropEl = document.getElementById('content-backdrop');
    const toggleEl = document.getElementById('content-toggle');
    const closeEl = document.getElementById('content-close');
    const belowLg = matchMedia('(max-width: 1023px)');

    function setDrawer(open) {
      if (!sidebarEl || !backdropEl || !toggleEl) return;
      sidebarEl.classList.toggle('max-lg:translate-x-full', !open);
      sidebarEl.classList.toggle('max-lg:translate-x-0', open);
      backdropEl.classList.toggle('hidden', !open);
      backdropEl.classList.toggle('block', open);
      toggleEl.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    /** called on lg+ (and on load): never leave stale drawer state behind */
    function resetDrawer() {
      if (!sidebarEl || !backdropEl || !toggleEl) return;
      sidebarEl.classList.remove('max-lg:translate-x-0');
      sidebarEl.classList.remove('max-lg:translate-x-full');
      backdropEl.classList.add('hidden');
      backdropEl.classList.remove('block');
      toggleEl.setAttribute('aria-expanded', 'false');
    }

    if (sidebarEl && backdropEl && toggleEl) {
      toggleEl.addEventListener('click', () => {
        if (!belowLg.matches) return;
        setDrawer(toggleEl.getAttribute('aria-expanded') !== 'true');
      });
      const closeDrawer = () => setDrawer(false);
      closeEl?.addEventListener('click', closeDrawer);
      backdropEl.addEventListener('click', closeDrawer);
      addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && belowLg.matches) closeDrawer();
      });
      // picking a lecture closes the drawer (mobile only matters)
      for (const row of rows) {
        row.addEventListener('click', () => {
          if (belowLg.matches) setDrawer(false);
        });
      }
      const onBreakpoint = () => {
        if (belowLg.matches) setDrawer(false);
        else resetDrawer();
      };
      belowLg.addEventListener('change', onBreakpoint);
      onBreakpoint();
    }

    const lessonTabs = Array.from(document.querySelectorAll('.watch-tab'));
    for (const tab of lessonTabs) {
      tab.addEventListener('click', () => {
        lessonTabs.forEach((item) => item.classList.toggle('is-active', item === tab));
        if (tab.hasAttribute('data-open-comments')) {
          const comments = document.getElementById('watch-comments');
          if (comments instanceof HTMLDetailsElement) comments.open = true;
        }
      });
    }
  </script>

  <style>
    .watch-page {
      --watch-radius: 1rem;
    }
    .watch-heading {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      min-width: 0;
      overflow: hidden;
      padding-block: 1rem 0.3rem;
      font-size: 0.7rem;
    }
    .watch-grid {
      align-items: start;
      direction: rtl;
    }
    .watch-rail {
      position: sticky;
      top: 4.5rem;
      min-height: calc(100dvh - 5.5rem);
      padding-inline-start: 0.35rem;
    }
    .watch-rail-link {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      min-height: 2.65rem;
      padding-inline: 0.65rem;
      border-radius: 0.7rem;
      color: var(--color-muted);
      font-size: 0.7rem;
      transition: color 150ms, background-color 150ms;
    }
    .watch-rail-link:hover {
      color: var(--color-ink);
      background: color-mix(in oklab, var(--color-panel) 72%, transparent);
    }
    .watch-rail-link.is-current {
      color: var(--color-accent);
      background: color-mix(in oklab, var(--color-accent) 9%, var(--color-panel));
      font-weight: 700;
    }
    .watch-tab {
      position: relative;
      display: inline-flex;
      min-height: 2.65rem;
      align-items: center;
      padding-inline: 0.9rem;
      color: var(--color-muted);
      font-size: 0.75rem;
      transition: color 150ms;
    }
    .watch-tab:hover,
    .watch-tab.is-active {
      color: var(--color-accent);
    }
    .watch-tab.is-active::after {
      position: absolute;
      inset-inline: 0.65rem;
      bottom: -1px;
      height: 2px;
      border-radius: 2px 2px 0 0;
      background: var(--color-accent);
      content: '';
    }
    .watch-overview {
      scroll-margin-top: 5rem;
    }
    @media (max-width: 639px) {
      .watch-heading { padding-block-start: 0.75rem; }
      .watch-titlebar { align-items: flex-start; }
      .watch-titlebar h1 { font-size: 1.1rem; }
      .watch-progress { font-size: 0.7rem; }
      .watch-stage { border-radius: 0.8rem; }
    }

    /* نقطة الإنجاز الدائرية (من «مسار تعلّم تفاعلي ٢»): مفرّغة افتراضيًا،
       تمتلئ بالأزرق الحبري مع صح أبيض بعد إتمام المحاضرة أو المقالة،
       والدرس الحالي نقطته بإطار وهالة — النص وحده يخفّت عند الإنجاز. */
    .wdot {
      width: 1rem;
      height: 1rem;
      border-radius: 9999px;
      border: 1.5px solid color-mix(in oklab, var(--color-control-edge) 70%, transparent);
      background: var(--color-surface);
      display: grid;
      place-items: center;
      transition:
        background-color 0.15s,
        border-color 0.15s,
        box-shadow 0.15s;
    }
    .wdot svg {
      width: 0.75rem;
      height: 0.75rem;
      opacity: 0;
      transition: opacity 0.15s;
    }
    .wdot.is-done {
      background: var(--color-accent);
      border-color: var(--color-accent);
    }
    .wdot.is-done svg {
      opacity: 1;
      color: var(--color-surface);
    }
    a[data-current] .wdot {
      border-color: var(--color-accent);
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-accent) 18%, transparent);
    }

    /* شريط تقدّم المسار: يمتلئ من اليمين (RTL) بنسبة الدروس المكتملة */
    .wbar {
