---
import Layout from '../layouts/Layout.astro';
import TrackExploreMap from '../components/graph/TrackExploreMap.astro';
import CircleCard from '../components/CircleCard.astro';
import { circles, structuredCircles } from '../lib/content';

// الرسم والبطاقات يعرضان المسارات الـ14 كلها — النص في الهيرو يقول 14 مسار
// والكومبوننتين يدعمان حالة «قيد الإعداد» (raw) أصلًا.
const graphCircles = circles.map((c) => ({
  id: c.id,
  name: c.name,
  icon: c.icon ?? '📚',
  color: c.color,
  status: c.status,
  prereqs: c.prereqs,
  topics: c.levels.reduce((a, l) => a + l.modules.reduce((b, m) => b + m.topics.length, 0), 0),
  tagline: c.tagline,
  levelNames: c.levels.map((l) => l.name),
  href: `/circles/${c.id}`,
}));

const totalTopics = structuredCircles.reduce((a, c) => a + c.levels.reduce((b, l) => b + l.modules.reduce((x, m) => x + m.topics.length, 0), 0), 0);
const totalResources = structuredCircles.reduce((a, c) =>
  a + c.levels.reduce((b, l) => b + l.modules.reduce((x, m) => x + m.resources.length + m.topics.reduce((y, t) => y + t.resources.length, 0), 0), 0),
  0,
);

const totalLevels = structuredCircles.reduce((a, c) => a + c.levels.length, 0);

const stats = [
  { v: circles.length, l: 'مسار' },
  { v: totalLevels, l: 'مستوى تعلّم' },
  { v: totalTopics, l: 'موضوع' },
  { v: totalResources, l: 'مصدر تعلّم' },
];

// أرقام الهيرو بأرقام غربية 0-9 — طلب المستخدم 2026-10-28 (ألغى قرار الأرقام الهندية السابق)
const ar = (n: number) => String(n);

// شركاء المجتمع — مصدرهم قسم «Parteners» في catreloaded.org (اللوجوهات في public/partners)
const partners = [
  { name: 'DarkEntry', url: 'https://darkentry.net/', logo: 'DarkEntry.png' },
  { name: 'OffSec', url: 'https://www.offsec.com/', logo: 'OffSec.png' },
  { name: 'HackerOne', url: 'https://www.hackerone.com', logo: 'Hackerone.png' },
  { name: 'FahemSec', url: 'https://fahemsec.com/', logo: 'FahemSec.png' },
  { name: 'CyEagle', url: 'https://www.cyeagle.io/', logo: 'CyEagle.png' },
  { name: 'ICPC Mansoura', url: 'https://www.facebook.com/ICPC.Mansoura', logo: 'ICPC_AfSNqqX2F.png' },
];
---
<Layout title="مسارات CAT Reloaded — ابدأ من هنا">
  <!-- hero — الاتجاه «تحريري» من design-explorations/hero-options.html (اعتماده 2026-10-27) -->
  <section class="hero-ed" aria-labelledby="hero-title">
    <div class="col-text">
      <h1 id="hero-title" class="h-display">رحلتك التعليمية كاملة في شبكة واحدة</h1>
      <p class="lede">
        14 مسار تعليمي من مجتمع CAT Reloaded معاد بناءها كواجهة تفاعلية: تصفّح المسارات، تابع تقدّمك موضوعًا بموضوع
        (محفوظ على جهازك)، وابدأ من أي نقطة.
      </p>

      <div class="rule-double" aria-hidden="true"></div>
      <p class="stats-line">
        {stats.map((s) => <span class="stat"><b>{ar(s.v)}</b><span>{s.l}</span></span>)}
      </p>

      <div class="search-row">
        <button type="button" class="field" data-open-search>
          <svg class="size-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <span class="ph">ابحث في المسارات والموضوعات والمصادر…</span>
          <kbd class="rounded border border-edge bg-panel px-1.5 font-mono text-[10px] text-muted">/</kbd>
        </button>
        <button type="button" class="go" data-open-search>بحث</button>
      </div>
      <button type="button" class="tour-start" data-start-tour>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
        جولة سريعة على الموقع
      </button>
    </div>

    <div class="col-art">
      <!-- صفحة منهج تنطلق منها شبكة مسارات — رسم خطي بالحبر (SVG، بلا صور خارجية) -->
      <svg viewBox="0 0 380 460" role="img" aria-label="رسم توضيحي: صفحة منهج مرتبطة بمسارات مترابطة">
        <rect class="pg" x="64" y="18" width="252" height="330" rx="10" />
        <line class="margin" x1="112" y1="34" x2="112" y2="332" />
        <rect class="pg-head" x="136" y="52" width="128" height="15" rx="4" />
        <rect class="pg-head" x="136" y="80" width="82" height="9" rx="4" opacity=".55"/>
        <line class="pg-line" x1="136" y1="120" x2="298" y2="120" />
        <line class="pg-line" x1="136" y1="140" x2="266" y2="140" />
        <line class="pg-line" x1="136" y1="160" x2="288" y2="160" />
        <circle cx="126" cy="196" r="4.5" fill="#f59e0b" />
        <line class="pg-line" x1="140" y1="196" x2="290" y2="196" />
        <line class="pg-line" x1="136" y1="226" x2="250" y2="226" />
        <line class="pg-line" x1="136" y1="246" x2="282" y2="246" />
        <circle cx="126" cy="282" r="4.5" fill="#38bdf8" />
        <line class="pg-line" x1="140" y1="282" x2="272" y2="282" />
        <line class="pg-line" x1="136" y1="312" x2="234" y2="312" />
        <path class="flow" d="M300 330 C 322 366, 296 382, 316 408" />
        <line class="link" x1="230" y1="348" x2="222" y2="404" />
        <line class="link" x1="150" y1="334" x2="112" y2="392" />
        <circle class="nd" cx="316" cy="416" r="11" fill="#f59e0b" fill-opacity=".9" stroke="var(--color-surface)" />
        <circle class="nd" cx="222" cy="412" r="9" fill="#38bdf8" fill-opacity=".9" stroke="var(--color-surface)" />
        <circle class="nd nd-wip" cx="112" cy="400" r="8.5" />
        <circle class="nd nd-wip" cx="352" cy="440" r="7" />
      </svg>
    </div>
  </section>

  <!-- partners — Logos من قسم Parteners في catreloaded.org — كل لوجو يدخل من اليمين ويختفي يسارًا في تدفّق لا نهائي -->
  <section class="ptn pb-14" aria-label="شركاؤنا">
    <h2 class="mb-2 text-center text-xl font-bold">شركاؤنا</h2>
    <div class="ptn-track">
      {partners.map((p, i) => (
        <a
          href={p.url}
          target="_blank"
          rel="noopener"
          class="ptn-card group flex h-20 w-52 items-center justify-center px-4"
          style={`animation-delay: ${-i * 4}s;`}
        >
          <img
            src={`/partners/${p.logo}`}
            alt={`لوجو ${p.name}`}
            loading="lazy"
            width="320"
            height="160"
            class="max-h-10 max-w-full object-contain opacity-80 grayscale transition group-hover:scale-[1.03] group-hover:opacity-100 group-hover:grayscale-0"
          />
        </a>
      ))}
    </div>
  </section>

  <!-- network graph -->
  <section class="pb-14" aria-label="شبكة المسارات">
    <div class="mb-4 flex items-baseline justify-between">
      <h2 class="text-xl font-bold">شبكة المسارات</h2>
      <span class="text-xs text-muted">انقر أي مسار لتمييزه وعلاقاته · اسحب للتحريك والتكبير</span>
    </div>
    <TrackExploreMap circles={graphCircles} />
  </section>

  <!-- cards -->
  <section aria-label="كل المسارات">
    <h2 class="mb-4 text-xl font-bold">كل المسارات</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {circles.map((c) => <CircleCard circle={c} />)}
    </div>
  </section>
</Layout>

<script>
  import { progressStore } from '../lib/progress';
  import { driver } from 'driver.js';
  import 'driver.js/dist/driver.css';

  const cards = document.querySelectorAll<HTMLElement>('[data-topic-keys]');
  const render = () => {
    for (const el of cards) {
      const keys: string[] = JSON.parse(el.dataset.topicKeys ?? '[]');
      const done = progressStore.countDone(keys);
      const pct = keys.length ? Math.round((done / keys.length) * 100) : 0;
      const bar = el.querySelector<HTMLElement>('[data-bar]');
      const label = el.querySelector<HTMLElement>('[data-pct]');
      if (bar) bar.style.width = `${pct}%`;
      if (label) label.textContent = `${done}/${keys.length}`;
    }
  };
  render();
  progressStore.subscribe(render);

  // زرا البحث في الهيرو يفتحان نفس نافذة البحث (SearchModal يستمع للحدث)
  for (const btn of document.querySelectorAll('[data-open-search]')) {
    btn.addEventListener('click', () => window.dispatchEvent(new CustomEvent('open-search')));
  }

  // ============ جولة Driver.js — تعريف أول زيارة بالصفحة الرئيسية ============
  const TOUR_DONE_KEY = 'cat.tour.v1';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const tour = driver({
    popoverClass: 'cat-tour',
    showProgress: true,
    progressText: '{{current}} من {{total}}',
    showButtons: ['next', 'previous', 'close'],
    nextBtnText: 'التالي',
    prevBtnText: 'السابق',
    doneBtnText: 'يلا نبدأ',
    overlayOpacity: 0.65,
    stageRadius: 14,
    disableActiveInteraction: true,
    smoothScroll: !reducedMotion,
    // إنهاء الترتيب أو الإغلاق مبكرًا كلاهما يعتبر «شاهدها» — لا نزعج الزائر بها ثانية
    onDestroyed: () => {
      try {
        localStorage.setItem(TOUR_DONE_KEY, '1');
      } catch {
        /* وضع التصفح الخاص — الجولة ستعرض مرة أخرى فقط في نفس الجلسة */
      }
    },
    steps: [
      {
        popover: {
          title: 'أهلًا بك في مسارات CAT 👋',
          description: 'جولة سريعة بأقل من دقيقة تعرّفك على أهم أماكن الصفحة. تنقّل بمفتاح Enter، واخرج متى شئت بمفتاح Escape.',
        },
      },
      {
        element: '.search-row',
        popover: {
          title: 'ابحث عن أي شيء',
          description: 'مسار، موضوع، أو مصدر تعلّم — اكتب واضغط Enter لفتح نافذة البحث فورًا.',
          side: 'bottom',
          align: 'start',
        },
      },
      {
        element: 'section[aria-label="شبكة المسارات"]',
        popover: {
          title: 'شبكة المسارات',
          description: 'كل مسار عقدة في شبكة مترابطة: انقر أي عقدة لتمييز مسارها ومتطلباته، واسحب للتحريك والتكبير.',
          side: 'top',
          align: 'start',
        },
      },
      {
        element: 'section[aria-label="كل المسارات"]',
        popover: {
          title: 'كل المسارات',
          description: 'بطاقة لكل مسار مستوياته ومصادره، وشريط يتابع تقدّمك داخله — محفوظ على جهازك.',
          side: 'top',
          align: 'start',
        },
      },
      {
        popover: {
          title: 'جاهز؟',
          description: 'اختر مسارًا وابدأ من أي نقطة — رحلتك محفوظة تلقائيًا على جهازك.',
        },
      },
    ],
  });

  const beginTour = () => {
    if (!tour.getState().isActive) tour.drive();
  };

  // أول زيارة: نؤخر الجولة قليلًا حتى تستقر التخطيطات والشبكة المرسومة برمجيًا
  let tourSeen = false;
  try {
    tourSeen = localStorage.getItem(TOUR_DONE_KEY) === '1';
  } catch {
    /* وضع التصفح الخاص */
  }
  if (!tourSeen) window.setTimeout(beginTour, 800);

  // زر «جولة سريعة على الموقع» يعيد تشغيلها في أي وقت
  document.querySelector<HTMLButtonElement>('[data-start-tour]')?.addEventListener('click', beginTour);
</script>

<style>
  /* ============ hero «تحريري» — القيم من الاتجاه المعتمد في design-explorations/hero-options.html ============ */
  .hero-ed {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: stretch;
    padding-block: clamp(2rem, 4vw, 3.5rem) 2rem;
  }
  .kicker {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .h-display {
    margin: 14px 0 0;
    max-width: 22ch;
    font-family: var(--font-header);
    font-size: clamp(2.1rem, 4.2vw, 3.1rem);
    font-weight: 700;
    line-height: 1.5; /* ارتفاع آمن للنسخ العربي */
    color: var(--color-ink);
  }
  .lede {
    margin: 18px 0 0;
    max-width: 46ch;
    color: var(--color-muted);
    line-height: 1.7;
  }
  .rule-double {
    margin-top: 22px;
    border-top: 4px double var(--color-edge);
  }
  .stats-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 26px;
    margin: 0;
    padding-top: 14px;
  }
  .stat {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .stat b {
    font-family: var(--font-header);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .stat span {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .search-row {
    display: flex;
    max-width: 46ch;
    min-width: 0; /* يسمح للمسار بالتقلّص — لا يفرض عرضه الأقصى على الموبايل */
    margin-top: 26px;
  }
  .field {
    display: flex;
    flex: 1;
    min-width: 0;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--color-surface);
    border: 1px solid var(--color-control-edge);
    border-start-start-radius: 10px;
    border-end-start-radius: 10px;
    border-start-end-radius: 0;
    border-end-end-radius: 0;
    cursor: pointer;
    text-align: start;
  }
  .field .ph {
    flex: 1 1 0%; /* ينمو ليملأ، ولا يدفعه النص الطويل عند حساب العرض الأدنى */
    width: 0;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .field:hover {
    border-color: var(--color-accent);
  }
  .go {
    padding: 0 22px;
    background: var(--color-accent);
    color: var(--color-surface);
    border: 1px solid var(--color-accent);
    border-start-end-radius: 10px;
    border-end-end-radius: 10px;
    border-start-start-radius: 0;
    border-end-start-radius: 0;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .go:hover {
    background: color-mix(in oklab, var(--color-accent) 88%, black);
  }
  /* زر جولة Driver.js — نص هادئ يندسّ في تحريرية الهيرو */
  .tour-start {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 14px;
    padding: 4px 0;
    font-size: 0.8125rem;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.15s;
  }
  .tour-start svg {
    width: 15px;
    height: 15px;
  }
  .tour-start:hover,
  .tour-start:focus-visible {
    color: var(--color-accent);
  }
  .col-art {
    display: grid;
    place-items: center;
  }
  .col-art svg {
    width: 100%;
    max-width: 380px;
    height: auto;
  }

  /* رسم الصفحة→الشبكة؛ ألوان المسارين من content/circles حرفيًا */
  .pg {
    fill: var(--color-surface);
    stroke: var(--color-edge);
    stroke-width: 1.5;
  }
  .pg-line {
    stroke: #e6e2d5;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .pg-head {
    fill: var(--color-ink);
  }
  .margin {
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: 0.28;
  }
  .flow {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .link {
    stroke: var(--color-edge);
    stroke-width: 1.5;
  }
  .nd {
    stroke-width: 2;
  }
  .nd-wip {
    fill: var(--color-surface);
    stroke: var(--color-muted);
    stroke-dasharray: 4 3;
  }

  /* ============ partners — تدفّق لا نهائي: كل لوجو يدخل من اليمين ويختفي يسارًا ============ */
  .ptn-track {
    position: relative;
    overflow: hidden;
    height: 6rem; /* يتسع للكارت h-20 وارتفاع الظل */
    /* تلاشي إضافي على الحافتين مع أوباسيتي الأنيميشن */
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }
  /* إحداثيات فيزيائية (right) لأن العنصر absolute والكومبوننت ثابت RTL — قرار مقصود */
  .ptn-card {
    position: absolute;
    top: 0.5rem;
    right: -12rem; /* مختفي خارج الحافة اليمين قبل بدء الدورة */
    /* background: var(--color-surface); */
    /* border: 1px solid var(--color-edge); */
    /* border-radius: 12px; */
    animation: ptn-cross 24s linear infinite;
  }
  .ptn-track:hover .ptn-card {
    animation-play-state: paused; /* القف على الماوس يوقف الحركة */
  }
  .ptn-card:hover {
    /* border-color: var(--color-control-edge); */
    box-shadow: 0 1px 0 0 color-mix(in oklab, var(--color-edge) 60%, transparent);
  }
  /* المرور الكامل: من خارج اليمين إلى خارج اليسار مع اختفاء عند الطرفين */
  @keyframes ptn-cross {
    0% { right: -12rem; opacity: 0; }
    8% { opacity: 1; }
    92% { opacity: 1; }
    100% { right: calc(100% + 12rem); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ptn-track {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      height: auto;
      mask-image: none;
      -webkit-mask-image: none;
    }
    .ptn-card {
      position: static;
      animation: none;
      opacity: 1;
    }
  }
  @media (max-width: 640px) {
    .ptn-card {
      width: 9rem; /* مساحة أقل على الموبايل */
      animation-duration: 16s; /* إيقاع يتجاوز عرض الكارت فلا يتداخل التدفّق */
    }
  }
  @media (max-width: 880px) {
    .hero-ed {
      grid-template-columns: 1fr;
    }
    .col-art {
      order: 2;
      margin-top: 1.5rem;
    }
    .col-art svg {
      max-width: 300px;
    }
    .go {
      padding: 0 14px;
    }
  }
</style>

<style is:global>
  /* ============ popover جولة Driver.js — بهوية الموقع وباتجاه RTL ============
     المحدّد المزدوج .cat-tour.driver-popover يتجاوز وزن خصائص driver.css الرسمي */
  .cat-tour.driver-popover {
    --driver-popover-font-family: inherit;
    direction: rtl;
    text-align: right;
    background: var(--color-surface);
    border: 1px solid var(--color-edge);
    border-radius: 14px;
    color: var(--color-ink);
    max-width: 340px;
    padding: 20px 22px 14px;
    box-shadow: 0 14px 40px rgb(38 49 58 / 0.16);
  }
  .cat-tour .driver-popover-title {
    font-family: var(--font-header);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.6;
  }
  .cat-tour .driver-popover-description {
    margin-top: 4px;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.85;
  }
  /* زر الإغلاق يرث left/right فيزيائيين من css المكتبة — نعكسه للـ RTL */
  .cat-tour .driver-popover-close-btn {
    right: auto;
    left: 0;
  }
  .cat-tour .driver-popover-progress-text {
    font-family: var(--font-header);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .cat-tour .driver-popover-footer-btn {
    border: 1px solid var(--color-edge);
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: border-color 0.15s, color 0.15s;
  }
  .cat-tour .driver-popover-footer-btn:hover,
  .cat-tour .driver-popover-footer-btn:focus {
