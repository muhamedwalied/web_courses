---
import Layout from '../../layouts/Layout.astro';
import CircleCurriculum from '../../components/CircleCurriculum.astro';
import SimilarCircles from '../../components/SimilarCircles.astro';
import { Icon } from 'astro-icon/components';
import { circleIcon } from '../../lib/circle-icons';
import { getCircle, structuredCircles } from '../../lib/content';
import sources from '../../../content/SOURCES.json';

export function getStaticPaths() {
  // only structured circles get a route — raw circles are hidden from the site
  return structuredCircles.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const circle = getCircle(id as string);
if (!circle) throw new Error(`unknown circle: ${id}`);

const structured = circle.status === 'structured';

// ---- real content stats (no invented numbers) ------------------------------
const levelCount = circle.levels.length;
const topicCount = circle.levels.reduce((acc, l) => acc + l.modules.reduce((a, m) => a + m.topics.length, 0), 0);
const resourceCount = circle.levels.reduce(
  (acc, l) =>
    acc + l.modules.reduce((a, m) => a + m.resources.length + m.topics.reduce((t, topic) => t + topic.resources.length, 0), 0),
  0,
);
const arabicResourceCount = circle.levels.reduce(
  (acc, l) =>
    acc +
    l.modules.reduce(
      (a, m) => a + m.resources.filter((r) => r.lang === 'ar').length + m.topics.reduce((t, topic) => t + topic.resources.filter((r) => r.lang === 'ar').length, 0),
      0,
    ),
  0,
);
const resourceLanguages = new Set(
  circle.levels.flatMap((level) =>
    level.modules.flatMap((module) => [
      ...module.resources.map((resource) => resource.lang),
      ...module.topics.flatMap((topic) => topic.resources.map((resource) => resource.lang)),
    ]),
  ),
);
const resourceLanguageLabel =
  resourceLanguages.size === 1
    ? resourceLanguages.has('en')
      ? 'المصادر بالإنجليزية'
      : 'المصادر بالعربية'
    : undefined;
const firstLevelDuration = [...circle.levels].sort((a, b) => a.order - b.order)[0]?.durationText;

// provenance from the vendoring record (SOURCES.json is rewritten by npm run vendor)
const upstream = sources.upstream;

// raw markdown files vendored under content/raw/<id>/ (kept for source transparency)
const rawFiles = Object.entries(
  import.meta.glob('../../content/raw/**/*.md', { eager: true }) as Record<string, { default: unknown }>,
).filter(([path]) => path.includes(`/content/raw/${circle.id}/`));
const sortedRaw = rawFiles.sort(([a], [b]) => {
  const main = (p: string) => (p.endsWith('/README.md') || p.endsWith('/Readme.md') ? 0 : 1);
  return main(a) - main(b) || a.localeCompare(b);
});

const taglineSegments = circle.tagline ? circle.tagline.split('→').map((s) => s.trim()).filter((s) => s.length > 0) : [];
const leadParagraph = (circle.overview?.paragraphs?.length ? circle.overview.paragraphs : [circle.description]).find(
  (p) => p.trim().length > 0,
);
---

<Layout title={`${circle.name} — مسارات CAT Reloaded`} description={circle.tagline ?? circle.description}>
  <!-- breadcrumb -->
  <header>
    <nav class="pt-5 text-sm text-muted" aria-label="مسار التنقل">
      <a href="/" class="transition hover:text-ink">المسارات</a>
      <span class="mx-2 text-edge">/</span>
      <span class="text-ink">{circle.name}</span>
    </nav>
  </header>

  <!-- editorial opener: text-first header — عنوان بارز ووصف مريح وعدّادات حقيقية (خيار «تحريري») -->
  <section class="mt-6" aria-label={`مقدمة مسار ${circle.name}`}>
    <div class="flex flex-wrap items-center gap-2.5">
      <span class="grid size-9 place-items-center rounded-[10px]" style={`background:${circle.color}1f;box-shadow:inset 0 0 0 1px ${circle.color}40`}>
        <Icon name={circleIcon(circle.id)} class="size-[19px] text-ink" />
      </span>
      <span class="font-mono text-xs text-accent">مسار</span>
      <span class={`rounded-full px-2.5 py-0.5 font-mono text-[10px] ${structured ? 'bg-accent/10 text-accent ring-1 ring-accent/30' : 'bg-edge/40 text-muted ring-1 ring-edge'}`}>
        {structured ? 'منظّم · تقدّم قابل للتتبّع' : 'قيد الإعداد'}
      </span>
      {resourceLanguageLabel && (
        <span class="rounded-full border border-edge bg-panel/60 px-2.5 py-0.5 text-[11px] leading-relaxed text-muted">
          {resourceLanguageLabel}
        </span>
      )}
    </div>

    <h1 dir="auto" class="mt-3.5 font-header text-[clamp(2rem,5vw,2.9rem)] font-bold leading-[1.45]">{circle.name}</h1>

    {
      circle.tagline && (
        <p class="mt-1 text-[15px] font-medium text-ink/90">
          {taglineSegments.length > 1
            ? taglineSegments.map((seg, i) => (
                <>
                  {i > 0 && <span class="mx-1.5 text-accent-2">←</span>}
                  <span>{seg}</span>
                </>
              ))
            : circle.tagline}
        </p>
      )
    }

    {leadParagraph && <p class="mt-4 max-w-[62ch] text-[15px] leading-[1.9] text-muted">{leadParagraph}</p>}

    <!-- metaline: only real facts, bold numerals on a hairline row -->
    <ul class="mt-5 flex flex-wrap gap-x-[18px] gap-y-1.5 border-y border-edge py-2.5 text-xs text-muted">
      <li><b class="font-bold text-ink">{levelCount}</b> مستويات</li>
      <li><b class="font-bold text-ink">{topicCount}</b> موضوع</li>
      <li><b class="font-bold text-ink">{resourceCount}</b> مصادر</li>
      {arabicResourceCount > 0 && (
        <li><b class="font-bold text-ink">{arabicResourceCount}</b> مصدر عربي</li>
      )}
      {firstLevelDuration && (
        <li>المرحلة الأولى: <b class="font-bold text-ink">{firstLevelDuration}</b></li>
      )}
    </ul>
  </section>

  <!-- two columns: actions sidebar (right in RTL) + main content (left) -->
  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[20rem_1fr] items-start">
    <aside class="space-y-5 lg:sticky lg:top-20">
      <!-- actions card -->
      <div class="rounded-2xl border border-edge bg-panel/70 p-5">
        <div class="flex items-baseline justify-between gap-2">
          <span class="text-3xl font-black text-ink">مجاني</span>
          <span class="rounded bg-edge/50 px-2 py-0.5 font-mono text-[10px] text-muted">بدون تسجيل</span>
        </div>

        <a
          href={`/start-${circle.id}/`}
          class="mt-4 block w-full rounded-lg bg-accent py-3 text-center font-bold text-bg transition hover:opacity-90"
        >
          ابدأ المسار
        </a>

        <a
          href={circle.github ?? 'https://github.com/CATReloaded/CATReloaded-Circles-Roadmaps'}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2.5 flex w-full items-center justify-center gap-2 rounded-lg border border-ink py-3 font-bold text-ink transition hover:bg-panel"
        >
          <Icon name="simple-icons:github" class="size-4" />
          <span>المصدر على GitHub</span>
          <Icon name="lucide:arrow-up-left" class="size-3.5" />
        </a>

        <p class="mt-3 inline-flex w-full items-center justify-center gap-1.5 text-xs text-muted">
          <Icon name="lucide:shield-check" class="size-3.5" />
          تقدّمك محفوظ على جهازك
        </p>

        <hr class="my-4 border-edge/70" />

        <ul class="space-y-2 text-sm text-muted">
          <li class="flex items-center gap-2"><Icon name="lucide:list-tree" class="size-4 shrink-0" /><span>{levelCount} مستويات تعليمية</span></li>
          <li class="flex items-center gap-2"><Icon name="lucide:file-text" class="size-4 shrink-0" /><span>{topicCount} موضوع</span></li>
          <li class="flex items-center gap-2"><Icon name="lucide:library" class="size-4 shrink-0" /><span>{resourceCount} مصادر</span></li>
          <li class="flex items-center gap-2"><Icon name="lucide:infinity" class="size-4 shrink-0" /><span>وصول مجاني دائم</span></li>
        </ul>

        <hr class="my-4 border-edge/70" />

        <div class="flex items-center justify-center gap-2 text-xs">
          <button
            type="button"
            id="copy-link-btn"
            data-label="انسخ اللينك"
            class="inline-flex items-center gap-1 text-muted transition hover:text-ink"
          >
            <Icon name="lucide:copy" class="size-3.5" />
            <span data-label>انسخ اللينك</span>
          </button>
          <span class="text-edge">•</span>
          <a href="/" class="inline-flex items-center gap-1.5 text-muted transition hover:text-ink">
            <span>الصفحة الرئيسية</span>
            <Icon name="lucide:arrow-up-left" class="size-3.5" />
          </a>
        </div>
      </div>

      <!-- provenance card: real vendoring facts only -->
      <div class="rounded-2xl border border-edge bg-panel/40 p-5">
        <p class="text-sm font-bold">مصدر المحتوى</p>
        <ul class="mt-3 space-y-2 font-mono text-[11px] text-muted">
          <li class="flex items-center gap-2"><Icon name="lucide:git-branch" class="size-3.5 shrink-0 text-accent/80" /><span dir="ltr" class="min-w-0 truncate">upstream/{upstream.branch}</span></li>
          <li class="flex items-center gap-2"><Icon name="lucide:git-commit-horizontal" class="size-3.5 shrink-0 text-accent/80" /><span dir="ltr" class="min-w-0 truncate">{upstream.commit.slice(0, 9)}</span></li>
          <li class="flex items-center gap-2"><Icon name="lucide:calendar-sync" class="size-3.5 shrink-0 text-accent/80" /><span>آخر مزامنة: {upstream.fetchedAt}</span></li>
        </ul>
        {upstream.note && <p class="mt-3 text-xs leading-6 text-muted">{upstream.note}</p>}
      </div>
    </aside>

    <!-- main column -->
    <main class="min-w-0">
      <CircleCurriculum circle={circle} />

      {
        !structured && (
          <section class="mt-10">
            <div class="mb-4 flex items-start gap-3 rounded-2xl border border-dashed border-edge bg-panel/40 p-4">
              <Icon name="lucide:construction" class="size-5 shrink-0 text-muted" />
              <p class="text-sm leading-7 text-muted">
                المحتوى ده لسه <b class="text-ink">مش منظّم</b>، معروض زي ما هو من الـ upstream. التقدّم والتتبّع بيتفعّلوا أول
                ما نعمل structured data للمسار ده.
              </p>
            </div>
            {sortedRaw.length > 0
              ? sortedRaw.map(([path, mod]) => {
                  const Content = mod.default;
                  return (
                    <section class="prose-raw mb-5 rounded-2xl border border-edge bg-panel/40 p-6">
                      <Content />
                    </section>
                  );
                })
              : (
                  <div class="rounded-2xl border border-edge bg-panel/40 p-10 text-center">
                    <p class="text-muted">المحتوى بتاع المسار ده مستضاف عند مصدر خارجي بيتجاب يدويًا — لسه ما اتسجّلش هنا.</p>
                  </div>
                )}
          </section>
        )
      }

      <SimilarCircles currentId={circle.id} />
    </main>
  </div>
</Layout>

<style>
  /* minimal typography for vendored upstream markdown */
  .prose-raw :global(h1) { font-size: 1.6rem; font-weight: 700; margin: 2rem 0 1rem; }
  .prose-raw :global(h2) { font-size: 1.3rem; font-weight: 700; margin: 1.75rem 0 0.75rem; border-bottom: 1px solid var(--color-edge); padding-bottom: 0.4rem; }
  .prose-raw :global(h3) { font-size: 1.1rem; font-weight: 700; margin: 1.4rem 0 0.6rem; }
  .prose-raw :global(h4), .prose-raw :global(h5), .prose-raw :global(h6) { font-weight: 600; margin: 1.1rem 0 0.5rem; }
  .prose-raw :global(p) { margin: 0.6rem 0; line-height: 1.9; }
  .prose-raw :global(ul), .prose-raw :global(ol) { margin: 0.6rem 0; padding-inline-start: 1.5rem; }
  .prose-raw :global(ul) { list-style: disc; }
  .prose-raw :global(ol) { list-style: decimal; }
  .prose-raw :global(li) { margin: 0.3rem 0; line-height: 1.85; }
  .prose-raw :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose-raw :global(blockquote) { border-inline-start: 3px solid var(--color-edge); padding-inline-start: 1rem; color: var(--color-muted); margin: 1rem 0; }
  .prose-raw :global(code) { font-family: var(--font-mono); font-size: 0.85em; background: var(--color-edge); border-radius: 4px; padding: 0.1em 0.4em; }
  .prose-raw :global(pre) { background: var(--color-surface); border: 1px solid var(--color-edge); border-radius: 10px; padding: 1rem; overflow-x: auto; direction: ltr; text-align: start; }
  .prose-raw :global(pre code) { background: none; padding: 0; }
  .prose-raw :global(table) { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
  .prose-raw :global(th), .prose-raw :global(td) { border: 1px solid var(--color-edge); padding: 0.5rem 0.75rem; text-align: start; }
  .prose-raw :global(th) { background: var(--color-surface); }
  .prose-raw :global(img) { max-width: 100%; border-radius: 10px; margin: 1rem 0; }
  .prose-raw :global(hr) { border-color: var(--color-edge); margin: 1.5rem 0; }
</style>

<script>
  const btn = document.getElementById('copy-link-btn');
  if (btn) {
    btn.addEventListener('click', async () => {
      const labelEl = btn.querySelector('[data-label]');
      const label = btn.dataset.label ?? labelEl?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(window.location.href);
        if (labelEl) labelEl.textContent = 'تم النسخ';
        setTimeout(() => {
          if (labelEl) labelEl.textContent = label;
        }, 1500);
      } catch {
        /* clipboard unavailable — leave the label untouched */
      }
    });
  }
</script>
