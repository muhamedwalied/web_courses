---
import Layout from '../../layouts/Layout.astro';
import CircleMap from '../../components/graph/CircleMap';
import { getCircle, countAllTopics, circleTopics, circles as all } from '../../lib/content';

export function getStaticPaths() {
  return all.map((c) => ({ params: { id: c.id } }));
}

const { id } = Astro.params;
const circle = getCircle(id as string);
if (!circle) throw new Error(`unknown circle: ${id}`);

const structured = circle.status === 'structured';
const counts = countAllTopics(circle);
const modulesCount = circle.levels.reduce((a, l) => a + l.modules.length, 0);

const stats = structured
  ? [
      { v: circle.levels.length, l: 'مستويات' },
      { v: modulesCount, l: 'موديولات' },
      { v: counts.required + counts.optional, l: 'موضوعات' },
      { v: counts.resources, l: 'مصادر' },
    ]
  : null;

// raw markdown files vendored under content/raw/<id>/ (populated by commit 10)
const rawFiles = Object.entries(
  import.meta.glob('../../content/raw/**/*.md', { eager: true }) as Record<string, { default: unknown }>,
).filter(([path]) => path.includes(`/content/raw/${circle.id}/`));
const sortedRaw = rawFiles.sort(([a], [b]) => {
  const main = (p: string) => (p.endsWith('/README.md') || p.endsWith('/Readme.md') ? 0 : 1);
  return main(a) - main(b) || a.localeCompare(b);
});

const upstreamUrl = circle.upstreamPaths.length
  ? `https://github.com/CATReloaded/CATReloaded-Circles-Roadmaps/tree/main/${encodeURIComponent(circle.upstreamPaths[0].replace(/\/$/, ''))}`
  : 'https://github.com/CATReloaded/CATReloaded-Circles-Roadmaps';

const allTopicKeys = structured ? circleTopics(circle).map((t) => t.key) : [];
---
<Layout title={`${circle.name} — مسارات CAT Reloaded`} description={circle.tagline ?? circle.description}>
  <nav class="pt-5 text-sm text-muted" aria-label="مسار التنقل">
    <a href="/" class="transition hover:text-ink">المسارات</a>
    <span class="mx-2 text-edge">/</span>
    <span class="text-ink">{circle.name}</span>
  </nav>

  <header class="flex flex-wrap items-start justify-between gap-4 pb-6 pt-4">
    <div class="flex items-start gap-4">
      <span class="grid size-14 shrink-0 place-items-center rounded-2xl text-2xl" style={`background:${circle.color}1f;box-shadow:inset 0 0 0 1px ${circle.color}40`}>
        {circle.icon}
      </span>
      <div>
        <div class="flex flex-wrap items-center gap-2.5">
          <h1 dir="ltr" class="text-3xl font-bold">{circle.name}</h1>
          <span class={`rounded-full px-2.5 py-0.5 font-mono text-[10px] ${structured ? 'bg-accent/10 text-accent ring-1 ring-accent/30' : 'bg-edge/40 text-muted ring-1 ring-edge'}`}>
            {structured ? 'منظّم — تقدّم قابل للتتبّع' : 'قيد الإعداد'}
          </span>
        </div>
        {circle.tagline && <p class="mt-1 text-muted">{circle.tagline}</p>}
        {circle.description && <p class="mt-2 max-w-2xl text-sm leading-7 text-muted">{circle.description}</p>}
      </div>
    </div>
    <a
      href={upstreamUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-lg border border-edge px-3 py-1.5 text-xs text-muted transition hover:border-accent/40 hover:text-ink"
    >
      المصدر الأصلي على GitHub ↗
    </a>
  </header>

  {
    stats && (
      <dl class="grid grid-cols-2 gap-3 pb-6 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="rounded-xl border border-edge bg-panel/50 px-4 py-3">
            <dd class="font-mono text-2xl font-semibold" style={`color:${circle.color}`}>
              {s.v}
            </dd>
            <dt class="mt-0.5 text-xs text-muted">{s.l}</dt>
          </div>
        ))}
      </dl>
    )
  }

  {
    structured && (
      <div data-topic-keys={JSON.stringify(allTopicKeys)} class="mb-6 flex items-center gap-3 rounded-xl border border-edge bg-panel/50 px-4 py-3">
        <span class="font-mono text-xs text-muted">
          تقدّمك هنا: <b id="circle-done" class="text-ink">0</b>/{allTopicKeys.length}
        </span>
        <div class="h-2 flex-1 overflow-hidden rounded-full bg-edge/70">
          <div id="circle-bar" class="h-full rounded-full transition-all duration-300" style={`width:0%;background:${circle.color}`}></div>
        </div>
        <span id="circle-pct" class="w-12 text-end font-mono text-xs" style={`color:${circle.color}`}>
          0%
        </span>
      </div>
    )
  }

  {
    structured ? (
      <CircleMap
        client:visible
        circle={{ id: circle.id, name: circle.name, color: circle.color, icon: circle.icon ?? '📚', levels: circle.levels }}
      />
    ) : (
      <div>
        <div class="mb-5 flex items-start gap-3 rounded-2xl border border-dashed border-edge bg-panel/40 p-4">
          <span class="mt-0.5 text-lg">🚧</span>
          <p class="text-sm leading-7 text-muted">
            المحتوى ده لسه <b class="text-ink">مش منظّم</b> — معروض زي ما هو من الـ upstream.
            التقدّم والتتبّع بيتفعّلوا أول ما نعمل structured data للمسار ده.
          </p>
        </div>
        {sortedRaw.length > 0 ? (
          sortedRaw.map(([path, mod]) => {
            const Content = mod.default;
            return (
              <section class="prose-raw rounded-2xl border border-edge bg-panel/40 p-6">
                <Content />
              </section>
            );
          })
        ) : (
          <div class="rounded-2xl border border-edge bg-panel/40 p-10 text-center">
            <p class="text-muted">المحتوى بتاع المسار ده مستضاف عند مصدر خارجي بيتجاب يدويًا — لسه ما اتسجّلش هنا.</p>
          </div>
        )}
      </div>
    )
  }
</Layout>

<style>
  /* minimal typography for vendored upstream markdown */
  .prose-raw :global(h1) { font-size: 1.6rem; font-weight: 700; margin: 2rem 0 1rem; }
  .prose-raw :global(h2) { font-size: 1.3rem; font-weight: 700; margin: 1.75rem 0 0.75rem; border-bottom: 1px solid var(--color-edge); padding-bottom: 0.4rem; }
  .prose-raw :global(h3) { font-size: 1.1rem; font-weight: 700; margin: 1.4rem 0 0.6rem; }
  .prose-raw :global(h4), .prose-raw :global(h5), .prose-raw :global(h6) { font-weight: 600; margin: 1.1rem 0 0.5rem; }
  .prose-raw :global(p) { margin: 0.6rem 0; line-height: 1.9; }
  .prose-raw :global(ul), .prose-raw :global(ol) { margin: 0.6rem 0; padding-inline-start: 1.5rem; }
  .prose-raw :global(ul) { list-style: disc; }
  .prose-raw :global(ol) { list-style: decimal; }
  .prose-raw :global(li) { margin: 0.3rem 0; line-height: 1.85; }
  .prose-raw :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .prose-raw :global(blockquote) { border-inline-start: 3px solid var(--color-edge); padding-inline-start: 1rem; color: var(--color-muted); margin: 1rem 0; }
  .prose-raw :global(code) { font-family: var(--font-mono); font-size: 0.85em; background: var(--color-edge); border-radius: 4px; padding: 0.1em 0.4em; }
  .prose-raw :global(pre) { background: var(--color-surface); border: 1px solid var(--color-edge); border-radius: 10px; padding: 1rem; overflow-x: auto; direction: ltr; text-align: left; }
  .prose-raw :global(pre code) { background: none; padding: 0; }
  .prose-raw :global(table) { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
  .prose-raw :global(th), .prose-raw :global(td) { border: 1px solid var(--color-edge); padding: 0.5rem 0.75rem; text-align: start; }
  .prose-raw :global(th) { background: var(--color-surface); }
  .prose-raw :global(img) { max-width: 100%; border-radius: 10px; margin: 1rem 0; }
  .prose-raw :global(hr) { border-color: var(--color-edge); margin: 1.5rem 0; }
</style>

<script>
  import { progressStore } from '../../lib/progress';

  const holder = document.querySelector<HTMLElement>('[data-topic-keys]');
  if (holder) {
    const keys: string[] = JSON.parse(holder.dataset.topicKeys ?? '[]');
    const doneEl = document.getElementById('circle-done')!;
    const barEl = document.getElementById('circle-bar')!;
    const pctEl = document.getElementById('circle-pct')!;
    const render = () => {
      const done = progressStore.countDone(keys);
      const pct = keys.length ? Math.round((done / keys.length) * 100) : 0;
      doneEl.textContent = String(done);
      barEl.style.width = `${pct}%`;
      pctEl.textContent = `${pct}%`;
    };
    render();
    progressStore.subscribe(render);
  }
</script>
